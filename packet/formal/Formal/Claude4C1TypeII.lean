namespace Claude4C1

open ClaudeChallenge Claude2Aligned

def bII0 (r s : ℕ) : Blk := ⟨![(r : ℤ) + s, (r : ℤ), 0, 0], ![0, -1, 0, 1], ![-1, 0, 0, 1], r⟩

def bII1 (r s : ℕ) : Blk := ⟨![(r : ℤ) + s, 0, 0, (r : ℤ)], ![-1, 0, 1, 0], ![-1, 0, 0, 1], r + s⟩

def bII2 (r s : ℕ) : Blk := ⟨![0, 0, (r : ℤ) + s, (r : ℤ)], ![0, 1, 0, -1], ![0, 1, -1, 0], r⟩

def bII3 (r s : ℕ) : Blk := ⟨![0, (r : ℤ), (r : ℤ) + s, 0], ![1, 0, -1, 0], ![0, 1, -1, 0], r + s⟩

def blkII (r s : ℕ) : List Blk := [bII0 r s, bII1 r s, bII2 r s, bII3 r s]

theorem ok_II0 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    StripOK r s (bII0 r s).pt (2 * (bII0 r s).L) :=
  blkOK_of _ 2 (by simp [bII0]) (by exact (by decide : RootIn ![0, -1, 0, 1] 2))
    (by exact (by decide : RootIn ![-1, 0, 0, 1] 2))
    (by exact (by decide : RootIn (![0, -1, 0, 1] - ![-1, 0, 0, 1]) 2)) ⟨0, by simp [bII0]⟩
    ⟨0, by simp [bII0]⟩ (fun m hm => by
      simp only [bII0] at hm
      rw [inS_iff]; simp [pt_apply, bII0] <;> omega)

theorem odd_II0 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    OddOK r s (bII0 r s).pt (2 * (bII0 r s).L) := by
  intro m hm hodd
  simp only [bII0] at hm
  rw [cornerP_iff, cornerP_iff]
  simp [pt_apply, bII0] <;> omega

