theorem jn_II0 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bII0 r s) (bII1 r s) := by
  refine ⟨?_, adjR_of_root (d := 2) (v := ![0, -1, 0, 1]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bII0, bII1] <;> omega
  · simp [pt_apply, bII0] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bII0, bII1] <;> omega
  · have := congrFun h 0; simp [pt_apply, bII0, bII1] at this <;> omega
  · have := congrFun h 1; simp [pt_apply, bII0, bII1] at this <;> omega

theorem jn_II1 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bII1 r s) (bII2 r s) := by
  refine ⟨?_, adjR_of_root (d := 0) (v := ![0, 1, 0, -1]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bII1, bII2] <;> omega
  · simp [pt_apply, bII1] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bII1, bII2] <;> omega
  · have := congrFun h 0; simp [pt_apply, bII1, bII2] at this <;> omega
  · have := congrFun h 1; simp [pt_apply, bII1, bII2] at this <;> omega

theorem jn_II2 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bII2 r s) (bII3 r s) := by
  refine ⟨?_, adjR_of_root (d := 0) (v := ![0, 1, 0, -1]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bII2, bII3] <;> omega
  · simp [pt_apply, bII2] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bII2, bII3] <;> omega
  · have := congrFun h 1; simp [pt_apply, bII2, bII3] at this <;> omega
  · have := congrFun h 0; simp [pt_apply, bII2, bII3] at this <;> omega

theorem chain_II (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) : Chain r s (blkII r s) :=
  ⟨ok_II0 r s hr hs,
    by simp [bII0] <;> omega,
    jn_II0 r s hr hs,
    ok_II1 r s hr hs,
    by simp [bII1] <;> omega,
    jn_II1 r s hr hs,
    ok_II2 r s hr hs,
    by simp [bII2] <;> omega,
    jn_II2 r s hr hs,
    ok_II3 r s hr hs,
    by simp [bII3] <;> omega⟩

theorem chainOdd_II (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) : ChainOdd r s (blkII r s) :=
  ⟨odd_II0 r s hr hs, odd_II1 r s hr hs, odd_II2 r s hr hs, odd_II3 r s hr hs, trivial⟩

