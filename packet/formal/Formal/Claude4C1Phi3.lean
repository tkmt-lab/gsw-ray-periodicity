theorem eqv_of_phi_4 (hr : 0 < r) (hs : 0 < s) (w : ℤ × ℤ)
    (hw : (c1Sig r s).InCell (4 : Fin 8) w) (b : (c1Sig r s).Site)
    (h : phi r s 4 w = phi r s b.1.1 b.1.2) :
    Relation.EqvGen (c1Sig r s).SamePoint ⟨((4 : Fin 8), w), hw⟩ b := by
  obtain ⟨⟨f, z⟩, hz⟩ := b
  have hw' := (inCell_iff hr hs _ _).1 hw
  have hz' := (inCell_iff hr hs _ _).1 hz
  have e0 := congrFun h 0
  have e1 := congrFun h 1
  have e2 := congrFun h 2
  have e3 := congrFun h 3
  simp only at e0 e1 e2 e3
  fin_cases f
  · refine Relation.EqvGen.rel _ _ ⟨2, 5, 4, _, gl_4_2, ?_⟩
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    ext <;> simp [rotN, rot] <;> omega
  · refine Relation.EqvGen.rel _ _ ⟨0, 5, 2, _, gl_4_0, ?_⟩
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    ext <;> simp [rotN, rot] <;> omega
  · refine Relation.EqvGen.rel _ _ ⟨1, 5, 0, _, gl_4_1, ?_⟩
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    ext <;> simp [rotN, rot] <;> omega
  · exfalso
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    omega
  · have hwz : w = z := by
      simp [phi] at e0 e1 e2 e3
      ext <;> omega
    subst hwz
    exact Relation.EqvGen.refl _
  · exfalso
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    omega
  · exfalso
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    omega
  · exfalso
    simp [CellIn, HexIn, TriIn] at hw' hz'
    simp [phi] at e0 e1 e2 e3
    omega

