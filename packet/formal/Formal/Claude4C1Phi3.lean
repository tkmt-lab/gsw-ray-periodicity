theorem eqv_of_phi (hr : 0 < r) (hs : 0 < s) (a b : (c1Sig r s).Site)
    (h : phi r s a.1.1 a.1.2 = phi r s b.1.1 b.1.2) : Relation.EqvGen (c1Sig r s).SamePoint a b := by
  obtain ⟨⟨g, w⟩, hw⟩ := a
  fin_cases g
  · exact eqv_of_phi_0 hr hs w hw b h
  · exact eqv_of_phi_1 hr hs w hw b h
  · exact eqv_of_phi_2 hr hs w hw b h
  · exact eqv_of_phi_3 hr hs w hw b h
  · exact eqv_of_phi_4 hr hs w hw b h
  · exact eqv_of_phi_5 hr hs w hw b h
  · exact eqv_of_phi_6 hr hs w hw b h
  · exact eqv_of_phi_7 hr hs w hw b h

/-- Inverse charts: the lattice point of cell `f` with image `x`. -/
def psi (r : ℤ) (f : Fin 8) (x : Fin 4 → ℤ) : ℤ × ℤ :=
  match f.val with
  | 0 => (x 2 - r, x 1)
  | 1 => (x 1 - r, x 3)
  | 2 => (x 3 - r, x 2)
  | 3 => (x 2 - r, x 3)
  | 4 => (x 3, x 2)
  | 5 => (x 2, x 3)
  | 6 => (x 3, x 1)
  | _ => (x 1, x 2)

theorem psi_spec (f : Fin 8) {x : Fin 4 → ℤ} (hx : InS r s x) (hf : x (faceK f) = faceV r s f) :
    CellIn r s f (psi r f x) ∧ phi r s f (psi r f x) = x := by
  rw [inS_iff] at hx
  fin_cases f <;> simp [faceK, faceV] at hf <;>
  · refine ⟨by simp [CellIn, HexIn, TriIn, psi] <;> omega, ?_⟩
    funext t; fin_cases t <;> simp [phi, psi] <;> omega

