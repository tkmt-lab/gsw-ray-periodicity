theorem fS1_deg_1 (r s : ℕ) (hr : 2 ≤ r) (hs : s = 1) (v : MS (r : ℤ) (s : ℤ)) (hv : v.1 = ch (r : ℤ) (s : ℤ) 1 ((-1), (1))) : deg (GM (r : ℤ) (s : ℤ)) v = 6 := by
  have hr1 : (1 : ℤ) ≤ r := by exact_mod_cast (show 1 ≤ r by omega)
  have hs1 : (1 : ℤ) ≤ s := by exact_mod_cast (show 1 ≤ s by omega)
  have hs0 : (s : ℤ) = 1 := by exact_mod_cast hs
  exact deg_int1 hr1 hs1 v (by simp only [I1] <;> omega) hv

theorem fS1_deg_n2 (r s : ℕ) (hr : 2 ≤ r) (hs : s = 1) (v : MS (r : ℤ) (s : ℤ)) (hv : v.1 = ch (r : ℤ) (s : ℤ) 0 ((-(r : ℤ) - 1), (2 * (r : ℤ) + 1))) : deg (GM (r : ℤ) (s : ℤ)) v = 6 := by
