theorem chain_IV (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : Chain r s (blkIV r s) :=
  ⟨ok_IV0 r s hr hs,
    by simp [bIV0] <;> omega,
    jn_IV0 r s hr hs,
    ok_IV1 r s hr hs,
    by simp [bIV1] <;> omega,
    jn_IV1 r s hr hs,
    ok_IV2 r s hr hs,
    by simp [bIV2] <;> omega,
    jn_IV2 r s hr hs,
    ok_IV3 r s hr hs,
    by simp [bIV3] <;> omega,
    jn_IV3 r s hr hs,
    ok_IV4 r s hr hs,
    by simp [bIV4] <;> omega,
    jn_IV4 r s hr hs,
    ok_IV5 r s hr hs,
    by simp [bIV5] <;> omega⟩

theorem chainOdd_IV (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : ChainOdd r s (blkIV r s) :=
