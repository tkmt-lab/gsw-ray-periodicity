theorem jn_IV0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bIV0 r s) (bIV1 r s) := by
  refine ⟨?_, adjR_of_root (d := 1) (v := ![-1, 0, 1, 0]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bIV0, bIV1] <;> omega
  · simp [pt_apply, bIV0] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bIV0, bIV1] <;> omega
  · have := congrFun h 0; simp [pt_apply, bIV0, bIV1] at this <;> omega
  · have := congrFun h 0; simp [pt_apply, bIV0, bIV1] at this <;> omega

