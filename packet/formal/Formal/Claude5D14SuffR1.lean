  have hs1 : (1 : ℤ) ≤ s := by exact_mod_cast (show 1 ≤ s by omega)
  have hr0 : (r : ℤ) = 1 := by exact_mod_cast hr
  have hS := strip_of_chain _ (fR1_chain r s hr hs)
  have hN : tot (fR1_bs r s) = (4 * s + 2) := by simp [fR1_bs, tot, fR1_0, fR1_1] <;> omega
  refine ⟨(4 * s + 2), fun k => ⟨wk (r : ℤ) (s : ℤ) (fR1_bs r s) (min k (tot (fR1_bs r s))), hS.1 _ (min_le_right _ _)⟩, ?_⟩
