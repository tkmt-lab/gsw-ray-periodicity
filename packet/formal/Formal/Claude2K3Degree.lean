    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
  · intro w hw
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl <;> dsimp only
