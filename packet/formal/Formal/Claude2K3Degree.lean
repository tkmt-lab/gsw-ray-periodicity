import Formal.Claude2K3Vertex

/-!
# K3 aligned surface, part 3: degrees of the vertices at the ends of the explicit paths

Written by a Claude worker (2026-10-19). Generated by a script from the Python mirror (class and
neighbour data), each proof checked here for all `r, s ≥ 2`:

* `deg_top_corner`      : the top corner `A0` (cell 10, `(0,0)`) has degree 5;
* `deg_top_seam`        : `(-1,1)` of cell 10 (on the hexagon seam, next to `A0`) has degree 6;
* `deg_top_cap`         : `(1,0)` of cell 10 (on the cap boundary, next to `A0`) has degree 6;
* `deg_bot_corner_c`    : the corner `(-s,s)` of hexagon `c ∈ {8,9,10}` has degree 5;
* `deg_bot_seam_c`      : `(1-s,s-1)` of hexagon `c` (seam, next to that corner) has degree 6;
* `deg_bot_cap_c`       : `(r-s-1,r+s)` of hexagon `c` (cap boundary, next to the corner
                          `(r-s,r+s)`) has degree 6.

Each proof lists all sites of the vertex (via the invariant `inv`), all unit steps from them,
the explicit gluings identifying the neighbours, and distinctness of the neighbours (via `inv`).
-/

set_option linter.unusedSimpArgs false

namespace Claude2K3
open ClaudeChallenge Claude2Aligned
variable {r s : ℤ}

theorem deg_top_corner (hr : 2 ≤ r) (hs : 2 ≤ s) :
    deg (k3Graph r s) (V r s 10 (0, 0)) = 5 := by
  have hr0 : 0 < r := by omega
  have hs0 : 0 < s := by omega
  rw [deg_eq hr0 hs0 (V r s 10 (0, 0)) [((10 : Fin 11), (0, 0)), ((0 : Fin 11), (0, 0)), ((8 : Fin 11), (r, r))]
    ([((10 : Fin 11), (1, 0)), ((10 : Fin 11), (0, 1)), ((10 : Fin 11), (-1, 1)), ((0 : Fin 11), (1, 0)), ((8 : Fin 11), (r - 1, r))].map (fun p => V r s p.1 p.2)) ?_ ?_ ?_ ?_]
  · rfl
  · intro g w hw hV
    have hi := V_inv hr0 hs0 hw (by simp [CellIn, TriIn, HexIn] <;> omega) hV
    fin_cases g <;> simp [inv, hgt, ang, nrm, CellIn, TriIn, HexIn, Prod.ext_iff] at hw hi ⊢ <;>
      (try split_ifs at hi) <;> omega
  · intro c hc u hu hcell
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    simp only [unitVec, List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hc with rfl | rfl | rfl <;> rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;> dsimp only at hcell ⊢
    · exact Or.inr (List.mem_map.2 ⟨((10 : Fin 11), (1, 0)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((10 : Fin 11), (0, 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((10 : Fin 11), (-1, 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exact Or.inr (List.mem_map.2 ⟨((0 : Fin 11), (1, 0)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((10 : Fin 11), (1, 0)), by simp,
        V_glue hr0 hs0 (gl_10_0 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)⟩)
