theorem odd10_0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : ∀ i, i < (b10_0 r s).L → ¬ IsCorner (r : ℤ) (s : ℤ) ((b10_0 r s).pt r s (2 * i + 1)) := by
