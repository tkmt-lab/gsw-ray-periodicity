theorem junc10_0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : Junc (r : ℤ) (s : ℤ) (b10_0 r s) (b10_1 r s) := by
  have hr1 := one_le_of_two hr; have hs1 := one_le_of_two hs
  have hL : 1 ≤ (b10_0 r s).L := by simp only [b10_0]; omega
  have n_e : (b10_0 r s).pt r s (2 * (b10_0 r s).L) = ch (r : ℤ) (s : ℤ) 0 ((-2 * (r : ℤ) - (s : ℤ)), (2 * (r : ℤ) + (s : ℤ))) := by
    rw [pt_e]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  have n_e1 : (b10_0 r s).pt r s (2 * (b10_0 r s).L - 1) = ch (r : ℤ) (s : ℤ) 0 ((-2 * (r : ℤ) - (s : ℤ) + 1), (2 * (r : ℤ) + (s : ℤ) - 1)) := by
    rw [pt_e1 _ hL]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  have n_e2 : (b10_0 r s).pt r s (2 * (b10_0 r s).L - 2) = ch (r : ℤ) (s : ℤ) 0 ((-2 * (r : ℤ) - (s : ℤ) + 1), (2 * (r : ℤ) + (s : ℤ))) := by
    rw [pt_e2 _ hL]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  have n_s0 : (b10_1 r s).pt r s 0 = ch (r : ℤ) (s : ℤ) 1 ((0), ((r : ℤ) + (s : ℤ))) := by
    rw [pt_0]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  have n_s1 : (b10_1 r s).pt r s 1 = ch (r : ℤ) (s : ℤ) 1 ((0), ((r : ℤ) + (s : ℤ) - 1)) := by
    rw [pt_1]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  have n_s2 : (b10_1 r s).pt r s 2 = ch (r : ℤ) (s : ℤ) 1 ((-1), ((r : ℤ) + (s : ℤ))) := by
    rw [pt_2]; simp only [b10_0, b10_1] <;> first | rfl | (congr 1; peq)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [n_e, n_s0] <;> exact ch01_of (by simp only [I0] <;> omega) (by simp only [I1] <;> omega) (by simp only [a0, a1] <;> split_ifs <;> aom)
  · rw [n_e1, n_s1]
    exact adj_via hr1 hs1 (c := 1) (P := ((1), ((r : ℤ) + (s : ℤ) - 1))) (Q := ((0), ((r : ℤ) + (s : ℤ) - 1))) (by norm_num) (by simp only [Dom, H0, H1] <;> omega) (by simp only [Dom, H0, H1] <;> omega) (by rw [unit_sub]; simp only [U2] <;> omega) (ch01_of (by simp only [I0] <;> omega) (by simp only [I1] <;> omega) (by simp only [a0, a1] <;> split_ifs <;> aom)) (by first | rfl | (congr 1; peq))
  · rw [n_s1, n_e2]; exact (ne_01 (Or.inl (by simp only [I0] <;> omega))).symm
  · rw [n_s2, n_e1]; exact (ne_01 (Or.inr (Or.inl (by simp only [I1] <;> omega)))).symm

