theorem ok10_0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : StripOK (r : ℤ) (s : ℤ) ((b10_0 r s).pt r s) (2 * (b10_0 r s).L) := by
  have hr1 := one_le_of_two hr; have hs1 := one_le_of_two hs
  refine blk_ok hr1 hs1 _ (by simp [b10_0]) (fun i hi => ?_) (fun i hi => ?_) (by simp [b10_0, unit_iff]) (by simp [b10_0, unit_iff]) (by simp [b10_0, unit_iff]) (by simp [b10_0, Prod.ext_iff]) (by simp [b10_0, Prod.ext_iff])
