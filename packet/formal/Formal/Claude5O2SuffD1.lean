import Formal.Claude5O2SuffBase

/-!
# O2 model: an explicit literal path for O2(t, 1), t ≥ 3: from B0 to D1 (generated)

Written by a Claude worker (2026-10-20, O2 bridge session); generated by `gen_suff.py` (session
scratchpad) from forced walks of the model.  Lean checks the blocks, the junctions, that the
points are distinct, and the degrees of the two ends and their neighbours, for every value of
the free parameter.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false
set_option maxHeartbeats 1000000

namespace Claude5O2

open ClaudeChallenge Claude2Aligned

def fD1_0 (t d : ℕ) : Blk := ⟨0, (((t : ℤ)), (0)), (1, 0), (0, 1), (t)⟩
def fD1_1 (t d : ℕ) : Blk := ⟨1, ((2 * (t : ℤ)), (0)), (-1, 1), (0, 1), (t + 1)⟩
def fD1_bs (t d : ℕ) : List Blk := [fD1_0 t d, fD1_1 t d]
theorem fD1_len (t d : ℕ) : (fD1_bs t d).length = 2 := rfl
theorem fD1_ok0 (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) : StripOK (t : ℤ) (d : ℤ) ((fD1_0 t d).pt t d) (2 * (fD1_0 t d).L) := by
  have ht1 : (1 : ℤ) ≤ t := by exact_mod_cast (show 1 ≤ t by omega)
  have hd1 : (1 : ℤ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  refine blk_ok ht1 hd1 _ (by simp [fD1_0]) (fun i hi => ?_) (fun i hi => ?_) (by simp [fD1_0, unit_iff]) (by simp [fD1_0, unit_iff]) (by simp [fD1_0, unit_iff]) (by simp [fD1_0, Prod.ext_iff]) (by simp [fD1_0, Prod.ext_iff])
  · simp only [fD1_0, Dom, Hx, Rh] at hi ⊢ <;> omega
  · simp only [fD1_0, Dom, Hx, Rh] at hi ⊢ <;> omega
theorem fD1_ok1 (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) : StripOK (t : ℤ) (d : ℤ) ((fD1_1 t d).pt t d) (2 * (fD1_1 t d).L) := by
  have ht1 : (1 : ℤ) ≤ t := by exact_mod_cast (show 1 ≤ t by omega)
  have hd1 : (1 : ℤ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  refine blk_ok ht1 hd1 _ (by simp [fD1_1]) (fun i hi => ?_) (fun i hi => ?_) (by simp [fD1_1, unit_iff]) (by simp [fD1_1, unit_iff]) (by simp [fD1_1, unit_iff]) (by simp [fD1_1, Prod.ext_iff]) (by simp [fD1_1, Prod.ext_iff])
  · simp only [fD1_1, Dom, Hx, Rh] at hi ⊢ <;> omega
  · simp only [fD1_1, Dom, Hx, Rh] at hi ⊢ <;> omega
theorem fD1_junc0 (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) : Junc (t : ℤ) (d : ℤ) (fD1_0 t d) (fD1_1 t d) := by
  have ht1 : (1 : ℤ) ≤ t := by exact_mod_cast (show 1 ≤ t by omega)
  have hd1 : (1 : ℤ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  have hL : 1 ≤ (fD1_0 t d).L := by simp only [fD1_0]; omega
  have n_e : (fD1_0 t d).pt t d (2 * (fD1_0 t d).L) = ch (t : ℤ) (d : ℤ) 0 ((2 * (t : ℤ)), (0)) := by
    rw [pt_e]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  have n_e1 : (fD1_0 t d).pt t d (2 * (fD1_0 t d).L - 1) = ch (t : ℤ) (d : ℤ) 0 ((2 * (t : ℤ) - 1), (1)) := by
    rw [pt_e1 _ hL]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  have n_e2 : (fD1_0 t d).pt t d (2 * (fD1_0 t d).L - 2) = ch (t : ℤ) (d : ℤ) 0 ((2 * (t : ℤ) - 1), (0)) := by
    rw [pt_e2 _ hL]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  have n_s0 : (fD1_1 t d).pt t d 0 = ch (t : ℤ) (d : ℤ) 1 ((2 * (t : ℤ)), (0)) := by
    rw [pt_0]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  have n_s1 : (fD1_1 t d).pt t d 1 = ch (t : ℤ) (d : ℤ) 1 ((2 * (t : ℤ)), (1)) := by
    rw [pt_1]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  have n_s2 : (fD1_1 t d).pt t d 2 = ch (t : ℤ) (d : ℤ) 1 ((2 * (t : ℤ) - 1), (1)) := by
    rw [pt_2]; simp only [fD1_0, fD1_1] <;> first | rfl | (congr 1; peq)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [n_e, n_s0] <;> exact tr_ch ht1 hd1 (by norm_num) (tr01 (by peq) (by simp only [OnD, or_true, true_or] <;> omega))
  · rw [n_e1, n_s1]
    exact adj_via ht1 (c := 0) (P := ((2 * (t : ℤ) - 1), (1))) (Q := ((2 * (t : ℤ)), (1))) (by norm_num) (by simp only [Dom, Hx, Rh, true_and, and_true] <;> omega) (by simp only [Dom, Hx, Rh, true_and, and_true] <;> omega) (by rw [unit_sub]; simp only [U2] <;> omega) (by first | rfl | (congr 1; peq)) (Eq.symm (tr_ch ht1 hd1 (by norm_num) (tr01 (by peq) (by simp only [OnD, or_true, true_or] <;> omega))))
  · rw [n_s1, n_e2]; exact (ne_01 (by simp only [ne_eq, Prod.mk.injEq, OnD] <;> omega)).symm
  · rw [n_s2, n_e1]; exact (ne_01 (by simp only [ne_eq, Prod.mk.injEq, OnD] <;> omega)).symm
theorem fD1_chain (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) : Chain (t : ℤ) (d : ℤ) (fD1_bs t d) := by
  simp only [fD1_bs, Chain]
  exact ⟨fD1_ok0 t d ht hd, by simp only [fD1_0]; omega, fD1_junc0 t d ht hd, fD1_ok1 t d ht hd, by simp only [fD1_1]; omega⟩
theorem fD1_cls (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) (k : ℕ) (hk : k < (4 * t + 2)) : (k < (2 * t) ∧ wk (t : ℤ) (d : ℤ) (fD1_bs t d) k = (fD1_0 t d).pt t d (k - (0))) ∨ ((2 * t) ≤ k ∧ wk (t : ℤ) (d : ℤ) (fD1_bs t d) k = (fD1_1 t d).pt t d (k - (2 * t))) := by
  by_cases h0 : k < (2 * t)
  · left
    have h := wk_at (fD1_bs t d) (fD1_chain t d ht hd) 0 (by rw [fD1_len]; norm_num) (k - (0)) (by show _ ≤ 2 * (fD1_0 t d).L; simp only [fD1_0] <;> omega)
    rw [show tot (List.take 0 (fD1_bs t d)) + (k - (0)) = k by simp [fD1_bs, tot, fD1_0, fD1_1] <;> omega, show (fD1_bs t d).get ⟨0, _⟩ = fD1_0 t d from rfl] at h
    exact ⟨by omega, h⟩
  · right
    have h := wk_at (fD1_bs t d) (fD1_chain t d ht hd) 1 (by rw [fD1_len]; norm_num) (k - (2 * t)) (by show _ ≤ 2 * (fD1_1 t d).L; simp only [fD1_1] <;> omega)
    rw [show tot (List.take 1 (fD1_bs t d)) + (k - (2 * t)) = k by simp [fD1_bs, tot, fD1_0, fD1_1] <;> omega, show (fD1_bs t d).get ⟨1, _⟩ = fD1_1 t d from rfl] at h
    exact ⟨by omega, h⟩
theorem fD1_inj (t d : ℕ) (ht : 3 ≤ t) (hd : d = 1) : ∀ i j, i < (4 * t + 2) → j < (4 * t + 2) → wk (t : ℤ) (d : ℤ) (fD1_bs t d) i = wk (t : ℤ) (d : ℤ) (fD1_bs t d) j → i = j := by
  have ht1 : (1 : ℤ) ≤ t := by exact_mod_cast (show 1 ≤ t by omega)
  have hd1 : (1 : ℤ) ≤ d := by exact_mod_cast (show 1 ≤ d by omega)
  intro i j hi hj e
  rcases fD1_cls t d ht hd i (by omega) with ⟨a0, e1⟩ | ⟨a0, e1⟩ <;>
    rcases fD1_cls t d ht hd j (by omega) with ⟨b0, e2⟩ | ⟨b0, e2⟩ <;>
    rw [e1, e2] at e <;> simp only [Blk.pt] at e
  · have := ch_inj ht1 (by simp [fD1_0]) (by simp only [Blk.pos, fD1_0, Dom, Hx, Rh] <;> omega) (by simp only [Blk.pos, fD1_0, Dom, Hx, Rh] <;> omega) e
    simp only [Blk.pos, fD1_0, Prod.mk.injEq] at this; omega
  · exact absurd e (ch_ne_of ht1 hd1 (by simp [fD1_0]) (by simp [fD1_1]) (by simp only [Blk.pos, fD1_0, Dom, Hx, Rh] <;> omega) (by simp only [Blk.pos, fD1_1, Dom, Hx, Rh] <;> omega) (by simp [fD1_0, fD1_1]) (by simp only [Tr, fD1_0, fD1_1]; rintro ⟨h1, h2⟩; simp only [fD1_0, fD1_1, Blk.pos, Prod.ext_iff, OnD] at h1 h2 <;> omega) (by simp [Tr, fD1_0, fD1_1]))
  · exact absurd e (ch_ne_of ht1 hd1 (by simp [fD1_1]) (by simp [fD1_0]) (by simp only [Blk.pos, fD1_1, Dom, Hx, Rh] <;> omega) (by simp only [Blk.pos, fD1_0, Dom, Hx, Rh] <;> omega) (by simp [fD1_1, fD1_0]) (by simp [Tr, fD1_1, fD1_0]) (by simp only [Tr, fD1_1, fD1_0]; rintro ⟨h1, h2⟩; simp only [fD1_1, fD1_0, Blk.pos, Prod.ext_iff, OnD] at h1 h2 <;> omega))
  · have := ch_inj ht1 (by simp [fD1_1]) (by simp only [Blk.pos, fD1_1, Dom, Hx, Rh] <;> omega) (by simp only [Blk.pos, fD1_1, Dom, Hx, Rh] <;> omega) e
    simp only [Blk.pos, fD1_1, Prod.mk.injEq] at this; omega
end Claude5O2
