  · rcases hp2 with ⟨hc, he⟩ | ⟨hc, he⟩
    · obtain ⟨rfl, rfl, rfl, rfl⟩ : x1 = (1) ∧ y1 = (0) ∧ x2 = (0) ∧ y2 = (1) :=
        ⟨by omega, by omega, by omega, by omega⟩
      exact kf3_0 t d ht hd hp h0 h1 h2
    · exfalso; omega
  · rcases hp2 with ⟨hc, he⟩ | ⟨hc, he⟩
    · obtain ⟨rfl, rfl, rfl, rfl⟩ : x1 = (0) ∧ y1 = (1) ∧ x2 = (-1) ∧ y2 = (1) :=
        ⟨by omega, by omega, by omega, by omega⟩
