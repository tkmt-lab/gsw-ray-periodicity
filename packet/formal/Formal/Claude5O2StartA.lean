theorem st0_0 (t d : ℕ) (ht : 2 ≤ t) (hd : 2 ≤ d) {n : ℕ} {p : ℕ → MS (t : ℤ) (d : ℤ)}
    (hp : LiteralPath (GM (t : ℤ) (d : ℤ)) n p) {P1 P2 : ℤ × ℤ}
    (h0 : (p 0).1 = ch (t : ℤ) (d : ℤ) 0 ((0), (0))) (h1 : (p 1).1 = ch (t : ℤ) (d : ℤ) 0 P1)
    (h2 : (p 2).1 = ch (t : ℤ) (d : ℤ) 0 P2) (hu1 : P1 - ((0), (0)) ∈ unitVec)
    (hp2 : P2 = ((0), (0)) + rotL (P1 - ((0), (0))) ∨ P2 = ((0), (0)) + rotR (P1 - ((0), (0))))
