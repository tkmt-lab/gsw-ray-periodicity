import Formal.Claude5D14Chart
import Mathlib.Tactic.Ring

/-!
# D14: cells are the charts, and the gluings preserve the model vertex

Written by a Claude worker (2026-10-20, D14 bridge session); the gluing table is generated by
`gen_phi.py` (`studies/R002/claude-lean/d14-scripts/`).

* `inCell_iff` : membership in a D14 cell is the hexagon of the chart;
* `Phi f z`    : the model vertex of the lattice point `z` of cell `f` (`ch` of the same point);
* `d14_pairs`  : every label-paired edge occurs in the 24-entry table `d14GlueTable`;
* `samePoint_phi` : `SamePoint` sites have the same image.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.style.maxHeartbeats false

namespace Claude5D14

open ClaudeChallenge Claude2Aligned

variable {r s : ℤ}

theorem rotN_add' (m n : ℕ) (x : ℤ × ℤ) : rotN (m + n) x = rotN m (rotN n x) := by
  induction m with
  | zero => simp [rotN]
  | succ m ih => rw [show m + 1 + n = (m + n) + 1 by omega]; simp only [rotN, ih]

theorem rotN_six_mul' (q : ℕ) (x : ℤ × ℤ) : rotN (6 * q) x = x := by
  induction q with
  | zero => simp [rotN]
  | succ q ih =>
    rw [show 6 * (q + 1) = 6 + 6 * q by ring, rotN_add', ih]
    ext <;> simp [rotN, rot]

theorem rotN_mod6 (n : ℕ) (x : ℤ × ℤ) : rotN n x = rotN (n % 6) x := by
  conv_lhs => rw [← Nat.mod_add_div n 6]
  rw [rotN_add', rotN_six_mul']

theorem sig_poly (f : Fin 2) : (d14Sig r s).poly f = d14Poly r s f := rfl

theorem poly0 : d14Poly r s 0 = [(0, 0), (s, 0), (s, r), (s, r + s), (s, 2 * r + s),
    (0, 2 * r + 2 * s), (-r, 2 * r + 2 * s), (-r - s, 2 * r + 2 * s), (-2 * r - s, 2 * r + 2 * s),
    (-2 * r - s, 2 * r + s), (-r - s, r + s), (-r, r)] := by
  simp only [d14Poly, walk, rotN, rot, Fin.isValue, Fin.val_zero, ↓reduceIte]
  simp only [List.cons.injEq, Prod.mk.injEq, Prod.mk_add_mk, and_true, true_and]
  omega

theorem poly1 : d14Poly r s 1 = [(0, 0), (r, 0), (r, s), (0, r + s), (-s, r + 2 * s),
    (-r - s, 2 * r + 2 * s), (-r - 2 * s, 2 * r + 2 * s), (-r - 2 * s, r + 2 * s),
    (-r - 2 * s, r + s), (-r - 2 * s, s), (-r - s, 0), (-s, 0)] := by
  simp only [d14Poly, walk, rotN, rot, Fin.isValue, Fin.val_one, one_ne_zero, ↓reduceIte]
  simp only [List.cons.injEq, Prod.mk.injEq, Prod.mk_add_mk, and_true, true_and]
  omega

theorem inCell0 (hr : 0 < r) (hs : 0 < s) (z : ℤ × ℤ) :
    (d14Sig r s).InCell (0 : Fin 2) z ↔ H0 r s z := by
  simp only [Sig.InCell, Sig.pt, sig_poly, poly0]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h3 := h 4 (by simp)
    have h4 := h 5 (by simp); have h6 := h 8 (by simp); have h7 := h 9 (by simp)
    simp [cross] at h0 h1 h3 h4 h6 h7
    exact ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c, e, g, k⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell1 (hr : 0 < r) (hs : 0 < s) (z : ℤ × ℤ) :
    (d14Sig r s).InCell (1 : Fin 2) z ↔ H1 r s z := by
  simp only [Sig.InCell, Sig.pt, sig_poly, poly1]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h3 := h 2 (by simp)
    have h4 := h 5 (by simp); have h6 := h 6 (by simp); have h7 := h 9 (by simp)
    simp [cross] at h0 h1 h3 h4 h6 h7
    exact ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c, e, g, k⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell_iff (hr : 0 < r) (hs : 0 < s) (f : Fin 2) (z : ℤ × ℤ) :
    (d14Sig r s).InCell f z ↔ Dom r s f.val z := by
  fin_cases f
  · exact inCell0 hr hs z
  · exact inCell1 hr hs z

/-- The model vertex of a site. -/
def Phi (r s : ℤ) (f : Fin 2) (z : ℤ × ℤ) : MV := ch r s f.val z

/-- The 24 directed edge gluings of D14: `(g, i, f, j, m)`. -/
def d14GlueTable : List (Fin 2 × ℕ × Fin 2 × ℕ × ℕ) :=
  [(0, 0, 1, 11, 3),
   (0, 1, 1, 10, 2),
   (0, 2, 1, 9, 1),
   (0, 3, 1, 8, 0),
   (0, 4, 1, 7, 5),
   (0, 5, 1, 6, 4),
   (0, 6, 1, 5, 3),
   (0, 7, 1, 4, 2),
   (0, 8, 1, 3, 1),
   (0, 9, 1, 2, 0),
   (0, 10, 1, 1, 5),
   (0, 11, 1, 0, 4),
   (1, 0, 0, 11, 2),
   (1, 1, 0, 10, 1),
   (1, 2, 0, 9, 0),
   (1, 3, 0, 8, 5),
   (1, 4, 0, 7, 4),
   (1, 5, 0, 6, 3),
   (1, 6, 0, 5, 2),
   (1, 7, 0, 4, 1),
   (1, 8, 0, 3, 0),
   (1, 9, 0, 2, 5),
   (1, 10, 0, 1, 4),
   (1, 11, 0, 0, 3)]

/-- D14 labels, independent of `r, s`. -/
def d14lb (g : Fin 2) (i : ℕ) : ℕ := (d14Lab g).getD (i % (d14Lab g).length) 0

theorem d14Sig_lb (r s : ℤ) (g : Fin 2) (i : ℕ) : (d14Sig r s).lb g i = d14lb g i := rfl

theorem d14_pairs : ∀ g : Fin 2, ∀ i : Fin 12, ∀ f : Fin 2, ∀ j : Fin 12,
    d14lb g i = d14lb f (j + 1) → d14lb g (i + 1) = d14lb f j →
    (g, i.val, f, j.val) ∈ d14GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  decide

theorem poly_length (r s : ℤ) (g : Fin 2) : ((d14Sig r s).poly g).length = 12 := by
  fin_cases g <;> simp [d14Sig, d14Poly, walk]

theorem glue_cases {g f : Fin 2} {i j m : ℕ} {τ : ℤ × ℤ} (hG : (d14Sig r s).Glue g i f j m τ) :
    (g, i, f, j) ∈ d14GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  obtain ⟨hi, hj, h1, h2, -, -⟩ := hG
  rw [d14Sig_lb, d14Sig_lb] at h1 h2
  rw [poly_length] at hi hj
  exact d14_pairs g ⟨i, hi⟩ f ⟨j, hj⟩ h1 h2

set_option maxHeartbeats 4000000 in
theorem samePoint_phi_0 (hr : 1 ≤ r) (hs : 1 ≤ s) (f : Fin 2) (z w : ℤ × ℤ)
    (hz : H0 r s z) (hw : Dom r s f.val w) (i j m : ℕ) (τ : ℤ × ℤ)
    (hG : (d14Sig r s).Glue (0 : Fin 2) i f j m τ) (hzw : rotN m z + τ = w) :
    Phi r s 0 z = Phi r s f w := by
  have hm := glue_cases hG
  obtain ⟨-, -, -, -, h3, h4⟩ := hG
  simp only [d14GlueTable, List.map_cons, List.map_nil, List.mem_cons, Prod.mk.injEq,
    Fin.isValue, Fin.reduceEq, true_and, false_and, false_or, List.not_mem_nil, or_false] at hm
  rw [rotN_mod6] at h3 h4 hzw
  have hm6 : m % 6 < 6 := Nat.mod_lt _ (by norm_num)
  generalize m % 6 = k at h3 h4 hzw hm6
  obtain ⟨z1, z2⟩ := z
  obtain ⟨w1, w2⟩ := w
  simp only [H0] at hz
  rcases hm with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ <;> simp only [Dom, H1, Fin.val_zero, Fin.val_one, Fin.isValue] at hw <;>
    (interval_cases k <;>
    simp only [rotN, rot, Sig.pt, sig_poly, poly0, poly1, Prod.ext_iff, Prod.fst_add, Prod.snd_add,
      List.length_cons, List.length_nil, Fin.isValue] at h3 h4 hzw <;>
    norm_num at h3 h4 hzw <;> (try omega)) <;>
    (show ch r s 0 (z1, z2) = ch r s 1 (w1, w2)
     exact ch01_of (by simp only [I0]; omega) (by simp only [I1]; omega)
       (by simp only [a0, a1]; split_ifs <;> aom))

set_option maxHeartbeats 4000000 in
theorem samePoint_phi_1 (hr : 1 ≤ r) (hs : 1 ≤ s) (f : Fin 2) (z w : ℤ × ℤ)
    (hz : H1 r s z) (hw : Dom r s f.val w) (i j m : ℕ) (τ : ℤ × ℤ)
    (hG : (d14Sig r s).Glue (1 : Fin 2) i f j m τ) (hzw : rotN m z + τ = w) :
    Phi r s 1 z = Phi r s f w := by
  have hm := glue_cases hG
  obtain ⟨-, -, -, -, h3, h4⟩ := hG
  simp only [d14GlueTable, List.map_cons, List.map_nil, List.mem_cons, Prod.mk.injEq,
    Fin.isValue, Fin.reduceEq, true_and, false_and, false_or, List.not_mem_nil, or_false] at hm
  rw [rotN_mod6] at h3 h4 hzw
  have hm6 : m % 6 < 6 := Nat.mod_lt _ (by norm_num)
  generalize m % 6 = k at h3 h4 hzw hm6
  obtain ⟨z1, z2⟩ := z
  obtain ⟨w1, w2⟩ := w
  simp only [H1] at hz
  rcases hm with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ <;> simp only [Dom, H0, Fin.val_zero, Fin.val_one, Fin.isValue] at hw <;>
    (interval_cases k <;>
    simp only [rotN, rot, Sig.pt, sig_poly, poly0, poly1, Prod.ext_iff, Prod.fst_add, Prod.snd_add,
      List.length_cons, List.length_nil, Fin.isValue] at h3 h4 hzw <;>
    norm_num at h3 h4 hzw <;> (try omega)) <;>
    (show ch r s 1 (z1, z2) = ch r s 0 (w1, w2)
     exact (ch01_of (by simp only [I0]; omega) (by simp only [I1]; omega)
       (by simp only [a0, a1]; split_ifs <;> aom)).symm)

theorem samePoint_phi (hr : 1 ≤ r) (hs : 1 ≤ s) (a b : (d14Sig r s).Site)
    (h : (d14Sig r s).SamePoint a b) : Phi r s a.1.1 a.1.2 = Phi r s b.1.1 b.1.2 := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  obtain ⟨⟨f, w⟩, hw⟩ := b
  obtain ⟨i, j, m, τ, hG, hzw⟩ := h
  simp only at hG hzw ⊢
  have hz' := (inCell_iff (by omega) (by omega) g z).1 hz
  have hw' := (inCell_iff (by omega) (by omega) f w).1 hw
  change Fin 2 at g f
  fin_cases g
  · exact samePoint_phi_0 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_1 hr hs f z w hz' hw' i j m τ hG hzw

end Claude5D14
