import Formal.Claude5O2Eqv1b

/-!
# O2: sites with the same model vertex are the same vertex (cells 4–7)

Written by a Claude worker (2026-10-20, O2 bridge session); generated by `gen_phi.py` (session
scratchpad).  Two sites with the same image lie on one gluing (one `SamePoint` step).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Claude5O2

open ClaudeChallenge Claude2Aligned

variable {t d : ℤ}

theorem eqv_4_0 (ht : 1 ≤ t) (hd : 1 ≤ d) (z w : ℤ × ℤ) (hz : (o2Sig t d).InCell (4 : Fin 8) z)
    (hw : (o2Sig t d).InCell (0 : Fin 8) w) (h : Phi t d 4 z = Phi t d 0 w) :
    Relation.EqvGen (o2Sig t d).SamePoint ⟨((4 : Fin 8), z), hz⟩ ⟨((0 : Fin 8), w), hw⟩ := by
  have hz' := (inCell_iff (by omega) (by omega) _ _).1 hz
  have hw' := (inCell_iff (by omega) (by omega) _ _).1 hw
  simp [CellIn, TriIn, Hx] at hz' hw'
  rw [phi_4, phi_0] at h
  have hc := ch_eq ht hd (by norm_num) (by norm_num) (by simp [Dom, Hx, Rh]; omega)
    (by simp [Dom, Hx, Rh]; omega) h
  rcases hc with ⟨hc1, hc2⟩ | hc | hc
  · simp at hc1
  · simp [Tr] at hc
  · obtain ⟨l, hl0, hl1, hl2, hl3⟩ := hc
    simp only [sp, Prod.ext_iff] at hl2 hl3
    refine Relation.EqvGen.rel _ _ ⟨0, 4, 5, _, gl_4_0, ?_⟩
    ext <;> simp [rotN, rot] <;> omega

