/-- Two sites of different cells with the same model vertex: one `SamePoint` step. -/
theorem same01 (hr : 1 ≤ r) (hs : 1 ≤ s) (a b : (d12Sig r s).Site) (ha : a.1.1 = (0 : Fin 2))
    (hb : b.1.1 = (1 : Fin 2)) (h : ch r s 0 a.1.2 = ch r s 1 b.1.2) : (d12Sig r s).SamePoint a b := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  obtain ⟨⟨f, w⟩, hw⟩ := b
  change Fin 2 at g f
  simp only at ha hb h ⊢
  subst ha; subst hb
  have hz' := (inCell_iff (by omega) (by omega) 0 z).1 hz
  have hw' := (inCell_iff (by omega) (by omega) 1 w).1 hw
  obtain ⟨n0, n1, e⟩ := ch_eq01 h
  have ez := eq_P0 hr hs hz' n0
  have ew := eq_P1 hr hs hw' n1
  have hl := a0_range hr hs hz' n0
  rw [← e] at ew
  generalize a0 r s z = l at ez ew hl
  subst ez; subst ew
  unfold Sig.SamePoint
  simp only
  rcases (show ((0) ≤ l ∧ l ≤ (s)) ∨ ((s) ≤ l ∧ l ≤ (r + 2 * s)) ∨ ((r + 2 * s) ≤ l ∧ l ≤ (r + 3 * s)) ∨ ((r + 3 * s) ≤ l ∧ l ≤ (2 * r + 4 * s)) ∨ ((2 * r + 4 * s) ≤ l ∧ l ≤ (2 * r + 5 * s)) ∨ ((2 * r + 5 * s) ≤ l ∧ l ≤ (3 * r + 6 * s)) ∨ ((3 * r + 6 * s) ≤ l ∧ l ≤ (3 * r + 7 * s)) ∨ ((3 * r + 7 * s) ≤ l ∧ l ≤ (4 * r + 8 * s)) ∨ ((4 * r + 8 * s) ≤ l ∧ l ≤ (4 * r + 9 * s)) ∨ ((4 * r + 9 * s) ≤ l ∧ l ≤ (5 * r + 10 * s)) ∨ ((5 * r + 10 * s) ≤ l ∧ l ≤ (5 * r + 11 * s)) ∨ ((5 * r + 11 * s) ≤ l ∧ l ≤ (6 * r + 12 * s)) by omega) with ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩ | ⟨h0, h1⟩
  · exact ⟨0, 11, 2, ((0), (0)), gl_0, mp_0 hr hs h0 h1 hl.2⟩
  · exact ⟨1, 10, 1, ((-s), (0)), gl_1, mp_1 hr hs h0 h1 hl.2⟩
  · exact ⟨2, 9, 0, ((-r - 3 * s), (s)), gl_2, mp_2 hr hs h0 h1 hl.2⟩
  · exact ⟨3, 8, 5, ((-2 * r - 5 * s), (r + 4 * s)), gl_3, mp_3 hr hs h0 h1 hl.2⟩
  · exact ⟨4, 7, 4, ((-3 * r - 5 * s), (3 * r + 7 * s)), gl_4, mp_4 hr hs h0 h1 hl.2⟩
  · exact ⟨5, 6, 3, ((-2 * r - 2 * s), (4 * r + 8 * s)), gl_5, mp_5 hr hs h0 h1 hl.2⟩
  · exact ⟨6, 5, 2, ((2 * s), (4 * r + 6 * s)), gl_6, mp_6 hr hs h0 h1 hl.2⟩
  · exact ⟨7, 4, 1, ((2 * r + 5 * s), (2 * r + 2 * s)), gl_7, mp_7 hr hs h0 h1 hl.2⟩
  · exact ⟨8, 3, 0, ((3 * r + 5 * s), (-s)), gl_8, mp_8 hr hs h0 h1 hl.2⟩
  · exact ⟨9, 2, 5, ((2 * r + 3 * s), (-r - 2 * s)), gl_9, mp_9 hr hs h0 h1 hl.2⟩
  · exact ⟨10, 1, 4, ((r + s), (-r - s)), gl_10, mp_10 hr hs h0 h1 hl.2⟩
  · exact ⟨11, 0, 3, ((0), (0)), gl_11, mp_11 hr hs h0 h1 hl.2⟩

/-- **Same image, same vertex.** -/
theorem eqv_of_phi (hr : 1 ≤ r) (hs : 1 ≤ s) (a b : (d12Sig r s).Site)
    (h : Phi r s a.1.1 a.1.2 = Phi r s b.1.1 b.1.2) : Relation.EqvGen (d12Sig r s).SamePoint a b := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  obtain ⟨⟨f, w⟩, hw⟩ := b
  have hz' := (inCell_iff (by omega) (by omega) g z).1 hz
  have hw' := (inCell_iff (by omega) (by omega) f w).1 hw
  simp only [Phi] at h
  change Fin 2 at g f
  by_cases hgf : g = f
  · subst hgf
    have := ch_inj hr hs (Fin.isLt g) hz' hw' h
    subst this
    exact Relation.EqvGen.refl _
  · fin_cases g <;> fin_cases f
    · exact (hgf rfl).elim
    · exact Relation.EqvGen.rel _ _ (same01 hr hs _ _ rfl rfl h)
    · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ (same01 hr hs _ _ rfl rfl h.symm))
    · exact (hgf rfl).elim

