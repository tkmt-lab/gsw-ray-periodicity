theorem samePoint_phi_0 (ht : 1 ≤ t) (hd : 1 ≤ d) (f : Fin 8) (z w : ℤ × ℤ)
    (hz : CellIn t d 0 z) (hw : CellIn t d f w) (i j m : ℕ) (τ : ℤ × ℤ)
    (hG : (o2Sig t d).Glue (0 : Fin 8) i f j m τ) (hzw : rotN m z + τ = w) :
    Phi t d 0 z = Phi t d f w := by
  have hm := glue_cases hG
  obtain ⟨-, -, -, -, h3, h4⟩ := hG
  simp only [o2GlueTable, List.map_cons, List.map_nil, List.mem_cons, Prod.mk.injEq, Fin.isValue,
    Fin.reduceEq, true_and, false_and, false_or, List.not_mem_nil, or_false] at hm
  rw [rotN_mod6] at h3 h4 hzw
  have hm6 : m % 6 < 6 := Nat.mod_lt _ (by norm_num)
  generalize m % 6 = k at h3 h4 hzw hm6
  simp [CellIn, TriIn, Hx] at hz
  rcases hm with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ <;> simp [CellIn, TriIn, Hx] at hw
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_3, chR_AB2 ht (i := 0) rfl ?_]
    · ph_close
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_2, chR_BC2 ht (i := 0) rfl ?_ ?_]
    · ph_close
    · omega
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_1]
    · ph_close
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_5, chR_AB2 ht (i := 1) rfl ?_]
    · ph_close
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_4, chR_BC2 ht (i := 1) rfl ?_ ?_]
    · ph_close
    · omega
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_1]
    · ph_close
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_7, chR_AB2 ht (i := 2) rfl ?_]
    · ph_close
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_6, chR_BC2 ht (i := 2) rfl ?_ ?_]
    · ph_close
    · omega
    · omega
  · interval_cases k <;> simp only [rotN, rot, Sig.pt, o2Sig, o2Poly, walk, Prod.ext_iff, Fin.isValue,
      Fin.val_zero, Fin.val_one, Fin.val_two, List.length_cons, List.length_nil] at h3 h4 hzw <;>
      norm_num at h3 h4 hzw <;> (try omega)
    rw [phi_0, phi_1]
    · ph_close

