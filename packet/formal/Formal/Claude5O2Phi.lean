import Formal.Claude5O2Chart
import Mathlib.Tactic.Ring

/-!
# O2: cells to charts, and invariance under the gluings

Written by a Claude worker (2026-10-20, O2 bridge session).  The gluing table and the per-cell
cases of `samePoint_phi` are generated by `gen_phi.py` (session scratchpad).

* `inCell_iff` : membership in an O2 cell is linear (`Hx` for the hexagons, `TriIn`);
* `Phi f z`    : the model vertex of the lattice point `z` of cell `f` (`ch` of a chart point);
* `o2_pairs`   : every label-paired edge occurs in the 36-entry table `o2GlueTable`;
* `samePoint_phi` : `SamePoint` sites have the same image.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Claude5O2

open ClaudeChallenge Claude2Aligned

variable {t d : ℤ}

theorem rotN_add' (m n : ℕ) (x : ℤ × ℤ) : rotN (m + n) x = rotN m (rotN n x) := by
  induction m with
  | zero => simp [rotN]
  | succ m ih => rw [show m + 1 + n = (m + n) + 1 by omega]; simp only [rotN, ih]

theorem rotN_six_mul' (q : ℕ) (x : ℤ × ℤ) : rotN (6 * q) x = x := by
  induction q with
  | zero => simp [rotN]
  | succ q ih =>
    rw [show 6 * (q + 1) = 6 + 6 * q by ring, rotN_add', ih]
    ext <;> simp [rotN, rot]

theorem rotN_mod6 (n : ℕ) (x : ℤ × ℤ) : rotN n x = rotN (n % 6) x := by
  conv_lhs => rw [← Nat.mod_add_div n 6]
  rw [rotN_add', rotN_six_mul']

/-- The closed `t`-triangle `(0,0), (t,0), (0,t)`. -/
def TriIn (t : ℤ) (z : ℤ × ℤ) : Prop := 0 ≤ z.1 ∧ 0 ≤ z.2 ∧ z.1 + z.2 ≤ t

def CellIn (t d : ℤ) (f : Fin 8) (z : ℤ × ℤ) : Prop := if f.val < 2 then Hx t d z else TriIn t z

theorem inCell_tri (ht : 0 < t) (f : Fin 8) (hf : ¬ f.val < 2) (z : ℤ × ℤ) :
    (o2Sig t d).InCell f z ↔ TriIn t z := by
  have hp : (o2Sig t d).poly f = [(0, 0), (t, 0), (0, t)] := by
    simp [o2Sig, o2Poly, hf, walk, rotN, rot]
  simp only [Sig.InCell, Sig.pt, hp]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h2 := h 2 (by simp)
    simp [cross] at h0 h1 h2
    exact ⟨by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell_hex (ht : 0 < t) (hd : 0 < d) (f : Fin 8) (hf : f.val < 2) (z : ℤ × ℤ) :
    (o2Sig t d).InCell f z ↔ Hx t d z := by
  have hp : (o2Sig t d).poly f = [(0, 0), (t, 0), (2 * t, 0), (2 * t, d), (t, t + d),
      (0, 2 * t + d), (-d, 2 * t + d), (-d, t + d), (-d, d)] := by
    simp [o2Sig, o2Poly, hf, walk, rotN, rot]; ring_nf; try simp
  simp only [Sig.InCell, Sig.pt, hp]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h2 := h 2 (by simp)
    have h3 := h 3 (by simp); have h4 := h 4 (by simp); have h5 := h 5 (by simp)
    have h6 := h 6 (by simp); have h7 := h 7 (by simp); have h8 := h 8 (by simp)
    simp [cross] at h0 h1 h2 h3 h4 h5 h6 h7 h8
    exact ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c, e, g, k⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell_iff (ht : 0 < t) (hd : 0 < d) (f : Fin 8) (z : ℤ × ℤ) :
    (o2Sig t d).InCell f z ↔ CellIn t d f z := by
  unfold CellIn
  split_ifs with hf
  · exact inCell_hex ht hd f hf z
  · exact inCell_tri ht f hf z

/-- The chart of cell `f`. -/
def cc (f : Fin 8) : ℕ := ![0, 1, 2, 2, 3, 3, 4, 4] f

/-- The chart point of the lattice point `z` of cell `f`. -/
def cp (t d : ℤ) (f : Fin 8) (z : ℤ × ℤ) : ℤ × ℤ :=
  if f.val = 0 then z else if f.val = 1 then (z.2 - d, z.1 + d)
  else if f.val % 2 = 0 then (t - z.1, t - z.2) else (z.2, t - z.1 - z.2)

/-- The model vertex of a site. -/
def Phi (t d : ℤ) (f : Fin 8) (z : ℤ × ℤ) : MV := ch t d (cc f) (cp t d f z)

theorem phi_0 (z : ℤ × ℤ) : Phi t d 0 z = ch t d 0 z := rfl
theorem phi_1 (z : ℤ × ℤ) : Phi t d 1 z = ch t d 1 (z.2 - d, z.1 + d) := rfl
theorem phi_2 (z : ℤ × ℤ) : Phi t d 2 z = ch t d 2 (t - z.1, t - z.2) := rfl
theorem phi_3 (z : ℤ × ℤ) : Phi t d 3 z = ch t d 2 (z.2, t - z.1 - z.2) := rfl
theorem phi_4 (z : ℤ × ℤ) : Phi t d 4 z = ch t d 3 (t - z.1, t - z.2) := rfl
theorem phi_5 (z : ℤ × ℤ) : Phi t d 5 z = ch t d 3 (z.2, t - z.1 - z.2) := rfl
theorem phi_6 (z : ℤ × ℤ) : Phi t d 6 z = ch t d 4 (t - z.1, t - z.2) := rfl
theorem phi_7 (z : ℤ × ℤ) : Phi t d 7 z = ch t d 4 (z.2, t - z.1 - z.2) := rfl

theorem cc_lt (f : Fin 8) : cc f < 5 := by fin_cases f <;> decide

theorem cp_dom {f : Fin 8} {z : ℤ × ℤ} (h : CellIn t d f z) : Dom t d (cc f) (cp t d f z) := by
  fin_cases f <;> simp [CellIn, Hx, TriIn, cc, cp, Dom, Rh] at h ⊢ <;> omega

theorem chR_AB2 (ht : 1 ≤ t) {c i : ℕ} (hc : c = i + 2) {a b : ℤ} (h1 : a = 0) :
    ch t d c (a, b) = ch t d 0 (sp t d i b) := by
  subst hc; exact chR_AB ht i h1

theorem chR_BC2 (ht : 1 ≤ t) {c i : ℕ} (hc : c = i + 2) {a b : ℤ} (h1 : b = t) (h0 : 0 ≤ a) :
    ch t d c (a, b) = ch t d 0 (sp t d i (t + a)) := by
  subst hc; exact chR_BC ht i h1 h0

theorem chR_AD2 (ht : 1 ≤ t) (hd : 1 ≤ d) {c i : ℕ} (hi : i < 3) (hc : c = i + 2) {a b : ℤ}
    (h1 : b = 0) (h0 : 0 ≤ a) (h2 : a ≤ t) : ch t d c (a, b) = ch t d 1 (sp t d i a) := by
  subst hc; exact chR_AD ht hd hi h1 h0 h2

theorem chR_DC2 (ht : 1 ≤ t) (hd : 1 ≤ d) {c i : ℕ} (hi : i < 3) (hc : c = i + 2) {a b : ℤ}
    (h1 : a = t) (h0 : 0 ≤ b) (h2 : b ≤ t) : ch t d c (a, b) = ch t d 1 (sp t d i (t + b)) := by
  subst hc; exact chR_DC ht hd hi h1 h0 h2

/-- The 36 directed edge gluings of O2: `(g, i, f, j, m)`. -/
def o2GlueTable : List (Fin 8 × ℕ × Fin 8 × ℕ × ℕ) :=
  [(0, 0, 3, 0, 3),
   (0, 1, 2, 0, 3),
   (0, 2, 1, 5, 5),
   (0, 3, 5, 0, 1),
   (0, 4, 4, 0, 1),
   (0, 5, 1, 2, 1),
   (0, 6, 7, 0, 5),
   (0, 7, 6, 0, 5),
   (0, 8, 1, 8, 3),
   (1, 0, 6, 2, 1),
   (1, 1, 7, 1, 5),
   (1, 2, 0, 5, 5),
   (1, 3, 4, 2, 5),
   (1, 4, 5, 1, 3),
   (1, 5, 0, 2, 1),
   (1, 6, 2, 2, 3),
   (1, 7, 3, 1, 1),
   (1, 8, 0, 8, 3),
   (2, 0, 0, 1, 3),
   (2, 1, 3, 2, 5),
   (2, 2, 1, 6, 3),
   (3, 0, 0, 0, 3),
   (3, 1, 1, 7, 5),
   (3, 2, 2, 1, 1),
   (4, 0, 0, 4, 5),
   (4, 1, 5, 2, 5),
   (4, 2, 1, 3, 1),
   (5, 0, 0, 3, 5),
   (5, 1, 1, 4, 3),
   (5, 2, 4, 1, 1),
   (6, 0, 0, 7, 1),
   (6, 1, 7, 2, 5),
   (6, 2, 1, 0, 5),
   (7, 0, 0, 6, 1),
   (7, 1, 1, 1, 1),
   (7, 2, 6, 1, 1)]

/-- O2 labels, independent of `t, d`. -/
def o2lb (g : Fin 8) (i : ℕ) : ℕ := (o2Lab g).getD (i % (o2Lab g).length) 0

theorem o2Sig_lb (t d : ℤ) (g : Fin 8) (i : ℕ) : (o2Sig t d).lb g i = o2lb g i := rfl

theorem o2_pairs : ∀ g : Fin 8, ∀ i : Fin 9, ∀ f : Fin 8, ∀ j : Fin 9,
    i.val < (o2Lab g).length → j.val < (o2Lab f).length →
    o2lb g i = o2lb f (j + 1) → o2lb g (i + 1) = o2lb f j →
    (g, i.val, f, j.val) ∈ o2GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  decide

theorem o2_poly_length (t d : ℤ) (g : Fin 8) : (o2Poly t d g).length = (o2Lab g).length := by
  fin_cases g <;> rfl

theorem glue_cases {g f : Fin 8} {i j m : ℕ} {τ : ℤ × ℤ} (hG : (o2Sig t d).Glue g i f j m τ) :
    (g, i, f, j) ∈ o2GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  obtain ⟨hi, hj, h1, h2, -, -⟩ := hG
  rw [o2Sig_lb, o2Sig_lb] at h1 h2
  have hlg : ((o2Sig t d).poly g).length ≤ 9 := by
    rw [show (o2Sig t d).poly g = o2Poly t d g from rfl, o2_poly_length]
    fin_cases g <;> decide
  have hlf : ((o2Sig t d).poly f).length ≤ 9 := by
    rw [show (o2Sig t d).poly f = o2Poly t d f from rfl, o2_poly_length]
    fin_cases f <;> decide
  have hi' : i < (o2Lab g).length := by rw [← o2_poly_length t d g]; exact hi
  have hj' : j < (o2Lab f).length := by rw [← o2_poly_length t d f]; exact hj
  exact o2_pairs g ⟨i, by omega⟩ f ⟨j, by omega⟩ hi' hj' h1 h2

macro "ph_close" : tactic => `(tactic| first
  | (congr 1; (try simp only [sp]); ext <;> (try simp only) <;> omega)
  | (rw [ch1_onD ?h]; rotate_left; (simp only [OnD, sp]; omega); congr 1; (try simp only [sp]);
      ext <;> (try simp only) <;> omega)
  | (rw [eq_comm, ch1_onD ?h]; rotate_left; (simp only [OnD, sp]; omega); congr 1;
      (try simp only [sp]); ext <;> (try simp only) <;> omega))

