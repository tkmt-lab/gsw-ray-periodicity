def b3_0 (r s : ℕ) : Blk := ⟨0, ((0), (0)), (0, 1), (1, 0), (2 * r + 2 * s)⟩
def b3_1 (r s : ℕ) : Blk := ⟨1, ((-(r : ℤ) - 2 * (s : ℤ)), ((r : ℤ) + 2 * (s : ℤ))), (1, 0), (1, -1), (r + s)⟩
def b3_2 (r s : ℕ) : Blk := ⟨0, ((-2 * (r : ℤ) - (s : ℤ)), (2 * (r : ℤ) + 2 * (s : ℤ))), (1, -1), (0, -1), (2 * r + 2 * s)⟩
