    rw [hv, show 1 = tot ((pQp_bs r s).take 0) + (1) by simp only [pQp_bs, List.take, tot, pQp_b0, pQp_b1, pQp_b2] <;> omega]
    rw [wk_at _ hch 0 (by simp [pQp_bs]) _ (by simp only [List.get_eq_getElem, pQp_bs, List.getElem_cons_zero, List.getElem_cons_succ, pQp_b0, pQp_b1, pQp_b2] <;> omega)]
    simp only [List.get_eq_getElem, pQp_bs, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [show (1) = 2 * (0) + 1 by omega, pt_odd']
    all_goals (try simp only [pQp_b0])
    all_goals (first | rfl | (congr 1; d12peq))
  · intro v hv
    refine pQp_deg_n2 r s hr hs v ?_
    rw [hv, show (16 * s - 4) - 2 = tot ((pQp_bs r s).take 1) + (8 * s - 4) by simp only [pQp_bs, List.take, tot, pQp_b0, pQp_b1, pQp_b2] <;> omega]
    rw [wk_at _ hch 1 (by simp [pQp_bs]) _ (by simp only [List.get_eq_getElem, pQp_bs, List.getElem_cons_zero, List.getElem_cons_succ, pQp_b0, pQp_b1, pQp_b2] <;> omega)]
    simp only [List.get_eq_getElem, pQp_bs, List.getElem_cons_zero, List.getElem_cons_succ]
    rw [show (8 * s - 4) = 2 * (4 * s - 2) by omega, pt_even']
    all_goals (try simp only [pQp_b1])
    all_goals (first | rfl | (congr 1; d12peq))

end Claude7D12
