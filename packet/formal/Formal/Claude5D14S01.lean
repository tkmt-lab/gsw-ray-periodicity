  have hr1 := one_le_of_two hr; have hs1 := one_le_of_two hs
  refine blk_ok hr1 hs1 _ (by simp [b2_0]) (fun i hi => ?_) (fun i hi => ?_) (by simp [b2_0, unit_iff]) (by simp [b2_0, unit_iff]) (by simp [b2_0, unit_iff]) (by simp [b2_0, Prod.ext_iff]) (by simp [b2_0, Prod.ext_iff])
  · simp only [b2_0, Dom, H0, H1] at hi ⊢ <;> omega
  · simp only [b2_0, Dom, H0, H1] at hi ⊢ <;> omega
theorem odd2_0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) : ∀ i, i < (b2_0 r s).L → ¬ IsCorner (r : ℤ) (s : ℤ) ((b2_0 r s).pt r s (2 * i + 1)) := by
  have hr1 := one_le_of_two hr; have hs1 := one_le_of_two hs
  intro i hi hc
  rw [pt_odd'] at hc
  have := corner_pos hr1 hs1 (by simp [b2_0]) (by simp only [b2_0, Dom, H0, H1] at hi ⊢ <;> omega) hc
  simp only [b2_0, IsCornerPos] at this hi <;> omega

