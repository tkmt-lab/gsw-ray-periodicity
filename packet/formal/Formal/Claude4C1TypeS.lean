namespace Claude4C1

open ClaudeChallenge Claude2Aligned

def bS0 (r s : ℕ) : Blk := ⟨![(r : ℤ) + s, (r : ℤ), 0, 0], ![0, -1, 0, 1], ![-1, 0, 0, 1], r⟩

def bS1 (r s : ℕ) : Blk := ⟨![(r : ℤ) + s, 0, 0, (r : ℤ)], ![-1, 0, 1, 0], ![-1, 0, 0, 1], r + 1⟩

def blkS (r s : ℕ) : List Blk := [bS0 r s, bS1 r s]

theorem ok_S0 (r s : ℕ) (hr : 1 ≤ r) :
    StripOK r 1 (bS0 r 1).pt (2 * (bS0 r 1).L) :=
  blkOK_of _ 2 (by simp [bS0]) (by exact (by decide : RootIn ![0, -1, 0, 1] 2))
    (by exact (by decide : RootIn ![-1, 0, 0, 1] 2))
    (by exact (by decide : RootIn (![0, -1, 0, 1] - ![-1, 0, 0, 1]) 2)) ⟨0, by simp [bS0]⟩
    ⟨0, by simp [bS0]⟩ (fun m hm => by
      simp only [bS0] at hm
      rw [inS_iff]; simp [pt_apply, bS0] <;> omega)

theorem ok_S1 (r s : ℕ) (hr : 1 ≤ r) :
    StripOK r 1 (bS1 r 1).pt (2 * (bS1 r 1).L) :=
  blkOK_of _ 1 (by simp [bS1]) (by exact (by decide : RootIn ![-1, 0, 1, 0] 1))
    (by exact (by decide : RootIn ![-1, 0, 0, 1] 1))
    (by exact (by decide : RootIn (![-1, 0, 1, 0] - ![-1, 0, 0, 1]) 1)) ⟨0, by simp [bS1]⟩
    ⟨0, by simp [bS1]⟩ (fun m hm => by
      simp only [bS1] at hm
      rw [inS_iff]; simp [pt_apply, bS1] <;> omega)

theorem jn_S0 (r s : ℕ) (hr : 1 ≤ r) :
    Junc r 1 (bS0 r 1) (bS1 r 1) := by
  refine ⟨?_, adjR_of_root (d := 2) (v := ![0, -1, 0, 1]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bS0, bS1] <;> omega
  · simp [pt_apply, bS0] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bS0, bS1] <;> omega
  · have := congrFun h 0; simp [pt_apply, bS0, bS1] at this <;> omega
  · have := congrFun h 1; simp [pt_apply, bS0, bS1] at this <;> omega

theorem chain_S (r s : ℕ) (hr : 1 ≤ r) : Chain r 1 (blkS r 1) :=
  ⟨ok_S0 r s hr,
    by simp [bS0] <;> omega,
    jn_S0 r s hr,
    ok_S1 r s hr,
    by simp [bS1] <;> omega⟩

end Claude4C1
