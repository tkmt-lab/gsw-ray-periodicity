    (by exact (by decide : RootIn ![0, 0, 1, -1] 0))
    (by exact (by decide : RootIn (![0, -1, 1, 0] - ![0, 0, 1, -1]) 0)) ⟨1, by simp [bI1]⟩
    ⟨1, by simp [bI1]⟩ (fun m hm => by
