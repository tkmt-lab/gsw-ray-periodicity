theorem jn_I0 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bI0 r s) (bI1 r s) := by
  refine ⟨?_, adjR_of_root (d := 0) (v := ![0, -1, 1, 0]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bI0, bI1] <;> omega
  · simp [pt_apply, bI0] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bI0, bI1] <;> omega
  · have := congrFun h 0; simp [pt_apply, bI0, bI1] at this <;> omega
  · have := congrFun h 1; simp [pt_apply, bI0, bI1] at this <;> omega

theorem jn_I1 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bI1 r s) (bI2 r s) := by
  refine ⟨?_, adjR_of_root (d := 0) (v := ![0, -1, 1, 0]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bI1, bI2] <;> omega
  · simp [pt_apply, bI1] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bI1, bI2] <;> omega
  · have := congrFun h 1; simp [pt_apply, bI1, bI2] at this <;> omega
  · have := congrFun h 0; simp [pt_apply, bI1, bI2] at this <;> omega

theorem jn_I2 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bI2 r s) (bI3 r s) := by
  refine ⟨?_, adjR_of_root (d := 3) (v := ![0, 1, -1, 0]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
  · funext t; fin_cases t <;> simp [pt_apply, bI2, bI3] <;> omega
  · simp [pt_apply, bI2] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bI2, bI3] <;> omega
  · have := congrFun h 1; simp [pt_apply, bI2, bI3] at this <;> omega
  · have := congrFun h 0; simp [pt_apply, bI2, bI3] at this <;> omega

theorem chain_I (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) : Chain r s (blkI r s) :=
  ⟨ok_I0 r s hr hs,
    by simp [bI0] <;> omega,
    jn_I0 r s hr hs,
    ok_I1 r s hr hs,
    by simp [bI1] <;> omega,
    jn_I1 r s hr hs,
    ok_I2 r s hr hs,
    by simp [bI2] <;> omega,
    jn_I2 r s hr hs,
    ok_I3 r s hr hs,
    by simp [bI3] <;> omega⟩

theorem chainOdd_I (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) : ChainOdd r s (blkI r s) :=
  ⟨odd_I0 r s hr hs, odd_I1 r s hr hs, odd_I2 r s hr hs, odd_I3 r s hr hs, trivial⟩

