  · simp [pt_apply, bIII0] <;> omega
  · intro t; fin_cases t <;> simp [pt_apply, bIII0, bIII1] <;> omega
  · have := congrFun h 0; simp [pt_apply, bIII0, bIII1] at this <;> omega
  · have := congrFun h 0; simp [pt_apply, bIII0, bIII1] at this <;> omega

