theorem chain_III (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) : Chain r s (blkIII r s) :=
  ⟨ok_III0 r s hr hs,
    by simp [bIII0] <;> omega,
    jn_III0 r s hr hs,
    ok_III1 r s hr hs,
    by simp [bIII1] <;> omega,
    jn_III1 r s hr hs,
    ok_III2 r s hr hs,
    by simp [bIII2] <;> omega,
    jn_III2 r s hr hs,
    ok_III3 r s hr hs,
    by simp [bIII3] <;> omega,
    jn_III3 r s hr hs,
    ok_III4 r s hr hs,
    by simp [bIII4] <;> omega,
    jn_III4 r s hr hs,
    ok_III5 r s hr hs,
    by simp [bIII5] <;> omega⟩

