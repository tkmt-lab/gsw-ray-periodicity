theorem jn_III0 (r s : ℕ) (hr : 1 ≤ r) (hs : 2 ≤ s) :
    Junc r s (bIII0 r s) (bIII1 r s) := by
  refine ⟨?_, adjR_of_root (d := 2) (v := ![-1, 1, 0, 0]) (by decide) ?_ ?_, fun h => ?_, fun h => ?_⟩
