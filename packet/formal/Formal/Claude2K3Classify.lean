theorem V_corner_step (hr : 0 < r) (hs : 0 < s) {g f : Fin 11} {i j m : ℕ} {τ : ℤ × ℤ}
    (hG : (k3Sig r s).Glue g i f j m τ) (P Q : ℤ × ℤ) (hP : (k3Sig r s).pt g i = P)
    (hQ : (k3Sig r s).pt f (j + 1) = Q) : V r s g P = V r s f Q := by
  rw [← hP, ← hQ]; exact V_corner_glue hr hs hG


