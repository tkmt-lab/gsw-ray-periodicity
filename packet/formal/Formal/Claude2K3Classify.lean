/-- **Degree classification of sites**: a lattice point of a cell has degree 5 if it is a corner
of the cell and degree 6 otherwise (all `r, s ≥ 2`). -/
theorem deg_site (hr : 2 ≤ r) (hs : 2 ≤ s) (c : Fin 11) (z : ℤ × ℤ) (hz : CellIn r s c z) :
    (IsCorner r s c z ∧ deg (k3Graph r s) (V r s c z) = 5) ∨
    (¬ IsCorner r s c z ∧ deg (k3Graph r s) (V r s c z) = 6) := by
  obtain ⟨x, y⟩ := z
  fin_cases c

  · exact deg_site_0 hr hs x y hz
  · exact deg_site_1 hr hs x y hz
  · exact deg_site_2 hr hs x y hz
  · exact deg_site_3 hr hs x y hz
  · exact deg_site_4 hr hs x y hz
  · exact deg_site_5 hr hs x y hz
  · exact deg_site_6 hr hs x y hz
  · exact deg_site_7 hr hs x y hz
  · exact deg_site_8 hr hs x y hz
  · exact deg_site_9 hr hs x y hz
  · exact deg_site_10 hr hs x y hz

end Claude2K3

