import Formal.Claude2K3Local
import Formal.Claude2K3Corners

/-!
# K3 aligned surface: the degree classification

Written by a Claude worker (2026-10-19, K3 necessity session).  Generated by
`studies/R002/claude-lean/claude2_k3_gen_classify.py` (symbolic: no sampling of `r, s`).

* `deg_edge_c_i`  : every lattice point strictly inside edge `i` of cell `c` has degree 6
                    (all 42 directed edges, edge parameter `t` symbolic);
* `deg_int_c`     : every lattice point strictly inside cell `c` has degree 6 (all 11 cells,
                    including the middle cap triangles `3`, `7`);
* `deg_cell_corner` : every corner of every cell has degree 5 (chains of corner gluings to the
                    twelve representatives of `Claude2K3Corners.lean`);
* `deg_site`      : a site has degree 5 if it is a cell corner and degree 6 otherwise.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Claude2K3
open ClaudeChallenge Claude2Aligned
variable {r s : ℤ}

macro "cell_tac" : tactic =>
  `(tactic| (simp [CellIn, TriIn, HexIn, gmap, rotN, rot] <;> omega))

macro "fib_tac" : tactic =>
  `(tactic| (intro g w hw h; fin_cases g <;>
    simp [inv3, inv, hgt, ang, nrm, aux, CellIn, TriIn, HexIn, gmap, rotN, rot, Prod.ext_iff]
      at hw h ⊢ <;> (try split_ifs at h) <;> omega))

macro "pt_tac" : tactic =>
  `(tactic| (ext <;> simp [Sig.pt, k3Sig, k3Poly, walk, rotN, rot] <;> ring))

theorem nodup6 {α : Type} {a b c d e f : α} (h1 : a ≠ b) (h2 : a ≠ c) (h3 : a ≠ d) (h4 : a ≠ e)
    (h5 : a ≠ f) (h6 : b ≠ c) (h7 : b ≠ d) (h8 : b ≠ e) (h9 : b ≠ f) (h10 : c ≠ d) (h11 : c ≠ e)
    (h12 : c ≠ f) (h13 : d ≠ e) (h14 : d ≠ f) (h15 : e ≠ f) : [a, b, c, d, e, f].Nodup := by
  simp [List.nodup_cons, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15]

macro "nd_tac" : tactic =>
  `(tactic| (apply nodup6 <;>
    (simp [inv3, inv, hgt, ang, nrm, aux, gmap, rotN, rot, Prod.ext_iff] <;>
      (try split_ifs) <;> omega)))


