/-- The corners of a triangle cell. -/
theorem pt_tri (c : Fin 11) (hc : c.val < 8) (i : ℕ) :
    (k3Sig r s).pt c i = (0, 0) ∨ (k3Sig r s).pt c i = (r, 0) ∨ (k3Sig r s).pt c i = (0, r) := by
  have h3 : i % 3 < 3 := Nat.mod_lt _ (by norm_num)
  have hp : (k3Sig r s).poly c = [(0, 0), (r, 0), (0, r)] := by
    simp [k3Sig, k3Poly, hc, walk, rotN, rot]
  simp only [Sig.pt, hp, List.length_cons, List.length_nil]
  generalize i % 3 = k at h3 ⊢
  interval_cases k <;> simp

/-- The corners of a hexagon cell. -/
theorem pt_hex (c : Fin 11) (hc : ¬ c.val < 8) (i : ℕ) :
    (k3Sig r s).pt c i = (0, 0) ∨ (k3Sig r s).pt c i = (r, 0) ∨ (k3Sig r s).pt c i = (r, r) ∨
    (k3Sig r s).pt c i = (r - s, r + s) ∨ (k3Sig r s).pt c i = (-s, r + s) ∨
    (k3Sig r s).pt c i = (-s, s) := by
  have h6 : i % 6 < 6 := Nat.mod_lt _ (by norm_num)
  have hp : (k3Sig r s).poly c =
      [(0, 0), (r, 0), (r, r), (r - s, r + s), (-s, r + s), (-s, s)] := by
    simp [k3Sig, k3Poly, hc, walk, rotN, rot]; ring_nf
  simp only [Sig.pt, hp, List.length_cons, List.length_nil]
  generalize i % 6 = k at h6 ⊢
  interval_cases k <;> simp

/-- A site is a corner of its cell. -/
def IsCorner (r s : ℤ) (c : Fin 11) (z : ℤ × ℤ) : Prop := ∃ i, z = (k3Sig r s).pt c i


set_option maxHeartbeats 1000000 in
theorem deg_site_0 (hr : 2 ≤ r) (hs : 2 ≤ s) (x y : ℤ) (hz : CellIn r s 0 (x, y)) :
    (IsCorner r s 0 (x, y) ∧ deg (k3Graph r s) (V r s 0 (x, y)) = 5) ∨
    (¬ IsCorner r s 0 (x, y) ∧ deg (k3Graph r s) (V r s 0 (x, y)) = 6) := by
  simp only [CellIn, TriIn, Fin.isValue] at hz
  norm_num at hz
  by_cases k0 : x = 0 ∧ y = 0
  · obtain ⟨rfl, rfl⟩ := k0; exact Or.inl ⟨⟨0, by pt_tac⟩, deg_cc_0_0 hr hs⟩
  by_cases k1 : x = r ∧ y = 0
  · obtain ⟨rfl, rfl⟩ := k1; exact Or.inl ⟨⟨1, by pt_tac⟩, deg_cc_0_1 hr hs⟩
  by_cases k2 : x = 0 ∧ y = r
  · obtain ⟨rfl, rfl⟩ := k2; exact Or.inl ⟨⟨2, by pt_tac⟩, deg_cc_0_2 hr hs⟩
  have hnc : ¬ IsCorner r s 0 (x, y) := by
    rintro ⟨i, hi⟩
    rcases pt_tri (r := r) (s := s) 0 (by decide) i with h | h | h <;>
      rw [h, Prod.mk.injEq] at hi <;> omega
  refine Or.inr ⟨hnc, ?_⟩
  by_cases e0 : y = 0
  · exact (congrArg (fun z => deg (k3Graph r s) (V r s 0 z)) (by ext <;> simp <;> omega)).trans
      (deg_edge_0_0 hr hs (x) (by omega) (by omega))
  by_cases e1 : x + y = r
  · exact (congrArg (fun z => deg (k3Graph r s) (V r s 0 z)) (by ext <;> simp <;> omega)).trans
      (deg_edge_0_1 hr hs (y) (by omega) (by omega))
  by_cases e2 : x = 0
  · exact (congrArg (fun z => deg (k3Graph r s) (V r s 0 z)) (by ext <;> simp <;> omega)).trans
      (deg_edge_0_2 hr hs (r - y) (by omega) (by omega))
  exact deg_int_0 hr hs x y (by omega) (by omega) (by omega)

