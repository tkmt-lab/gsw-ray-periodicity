theorem redOK {p r s w k : ℤ} (H : Hyp p r s w) (TW : Tw p r s w k) (G : Reg r s k) :
    RedOK p r s w k (T r s k) where
  startC := by
    intro c hc i hi
    rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl <;> rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl
    exacts [startC_0_0 H G, startC_0_1 H G, startC_1_0 H G, startC_1_1 H G]
  capT := by
    intro c hc j hj
    rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl <;> interval_cases j
    exacts [capT_0_0 H TW G, capT_0_1 H TW G, capT_0_2 H TW G, capT_0_3 H TW G, capT_0_4 H TW G, capT_0_5 H TW G, capT_1_0 H TW G, capT_1_1 H TW G, capT_1_2 H TW G, capT_1_3 H TW G, capT_1_4 H TW G, capT_1_5 H TW G]
  Tcap := by
    intro c hc j hj
    rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl <;> rcases (show j = 0 ∨ j = 1 by omega) with rfl | rfl
    exacts [Tcap_0_0 H TW G, Tcap_0_1 H TW G, Tcap_1_0 H TW G, Tcap_1_1 H TW G]
  avoidC := by
    intro c hc
    rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl
    exacts [avoidC_0 H G, avoidC_1 H G]
  avoidT := avoidT H G
  startT := startT H G

