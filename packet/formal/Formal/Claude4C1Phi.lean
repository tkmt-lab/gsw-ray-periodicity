theorem samePoint_phi (hr : 0 < r) (hs : 0 < s) (a b : (c1Sig r s).Site)
    (h : (c1Sig r s).SamePoint a b) : phi r s a.1.1 a.1.2 = phi r s b.1.1 b.1.2 := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  obtain ⟨⟨f, w⟩, hw⟩ := b
  obtain ⟨i, j, m, τ, hG, hzw⟩ := h
  have hz' := (inCell_iff hr hs g z).1 hz
  have hw' := (inCell_iff hr hs f w).1 hw
  simp only
  fin_cases g
  · exact samePoint_phi_0 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_1 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_2 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_3 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_4 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_5 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_6 hr hs f z w hz' hw' i j m τ hG hzw
  · exact samePoint_phi_7 hr hs f z w hz' hw' i j m τ hG hzw

