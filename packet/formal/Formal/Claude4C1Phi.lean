import Formal.Claude4C1G4
import Mathlib.Tactic.Ring
import Mathlib.Tactic.IntervalCases

/-!
# C1: the map from cell charts to the `ℤ⁴` model, and its invariance under the gluings

Written by a Claude worker (2026-10-20, C1 bridge session).  The per-cell cases of
`samePoint_phi` are generated by `gen_phi1.py` (session scratchpad) from the gluing table.

* `inCell_iff` : for `0 < r, 0 < s`, membership in a C1 cell is linear (`HexIn`, `TriIn`);
* `phi f z`    : the point of `ℤ⁴` of the lattice point `z` of cell `f` (affine in `z`);
* `phi_inS`, `phi_face` : it lies on the surface, in the face `faceK f` (value `faceV f`);
* `c1_pairs`   : every label-paired edge occurs in the 36-entry table `c1GlueTable`;
* `samePoint_phi` : `SamePoint` sites have the same image.
-/

set_option linter.unusedSimpArgs false

namespace Claude4C1

open ClaudeChallenge Claude2Aligned

theorem rotN_add' (m n : ℕ) (x : ℤ × ℤ) : rotN (m + n) x = rotN m (rotN n x) := by
  induction m with
  | zero => simp [rotN]
  | succ m ih => rw [show m + 1 + n = (m + n) + 1 by omega]; simp only [rotN, ih]

theorem rotN_six_mul' (q : ℕ) (x : ℤ × ℤ) : rotN (6 * q) x = x := by
  induction q with
  | zero => simp [rotN]
  | succ q ih =>
    rw [show 6 * (q + 1) = 6 + 6 * q by ring, rotN_add', ih]
    ext <;> simp [rotN, rot]

theorem rotN_mod6 (n : ℕ) (x : ℤ × ℤ) : rotN n x = rotN (n % 6) x := by
  conv_lhs => rw [← Nat.mod_add_div n 6]
  rw [rotN_add', rotN_six_mul']

/-- The closed `r`-triangle `(0,0), (r,0), (0,r)`. -/
def TriIn (r : ℤ) (z : ℤ × ℤ) : Prop := 0 ≤ z.2 ∧ z.1 + z.2 ≤ r ∧ 0 ≤ z.1

/-- The closed hexagon `(0,0),(s,0),(s,r),(0,r+s),(-r,r+s),(-r,r)`. -/
def HexIn (r s : ℤ) (z : ℤ × ℤ) : Prop :=
  0 ≤ z.2 ∧ z.1 ≤ s ∧ z.1 + z.2 ≤ r + s ∧ z.2 ≤ r + s ∧ -r ≤ z.1 ∧ 0 ≤ z.1 + z.2

def CellIn (r s : ℤ) (f : Fin 8) (z : ℤ × ℤ) : Prop :=
  if f.val < 4 then HexIn r s z else TriIn r z

variable {r s : ℤ}

theorem inCell_tri (hr : 0 < r) (f : Fin 8) (hf : ¬ f.val < 4) (z : ℤ × ℤ) :
    (c1Sig r s).InCell f z ↔ TriIn r z := by
  have hp : (c1Sig r s).poly f = [(0, 0), (r, 0), (0, r)] := by
    simp [c1Sig, c1Poly, hf, walk, rotN, rot]
  simp only [Sig.InCell, Sig.pt, hp]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h2 := h 2 (by simp)
    simp [cross] at h0 h1 h2
    exact ⟨by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell_hex (hr : 0 < r) (hs : 0 < s) (f : Fin 8) (hf : f.val < 4) (z : ℤ × ℤ) :
    (c1Sig r s).InCell f z ↔ HexIn r s z := by
  have hp : (c1Sig r s).poly f =
      [(0, 0), (s, 0), (s, r), (0, r + s), (-r, r + s), (-r, r)] := by
    simp [c1Sig, c1Poly, hf, walk, rotN, rot]
  simp only [Sig.InCell, Sig.pt, hp]
  constructor
  · intro h
    have h0 := h 0 (by simp); have h1 := h 1 (by simp); have h2 := h 2 (by simp)
    have h3 := h 3 (by simp); have h4 := h 4 (by simp); have h5 := h 5 (by simp)
    simp [cross] at h0 h1 h2 h3 h4 h5
    exact ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩
  · rintro ⟨a, b, c, d, e, g⟩ i hi
    simp at hi
    interval_cases i <;> simp [cross] <;> nlinarith

theorem inCell_iff (hr : 0 < r) (hs : 0 < s) (f : Fin 8) (z : ℤ × ℤ) :
    (c1Sig r s).InCell f z ↔ CellIn r s f z := by
  unfold CellIn
  split_ifs with hf
  · exact inCell_hex hr hs f hf z
  · exact inCell_tri hr f hf z

/-- The point of `ℤ⁴` of the lattice point `z` of cell `f`. -/
def phi (r s : ℤ) (f : Fin 8) (z : ℤ × ℤ) : Fin 4 → ℤ :=
  match f.val with
  | 0 => ![r + s - z.1 - z.2, z.2, r + z.1, 0]
  | 1 => ![r + s - z.1 - z.2, r + z.1, 0, z.2]
  | 2 => ![r + s - z.1 - z.2, 0, z.2, r + z.1]
  | 3 => ![0, r + s - z.1 - z.2, r + z.1, z.2]
  | 4 => ![r + s, r - z.1 - z.2, z.2, z.1]
  | 5 => ![r - z.1 - z.2, r + s, z.1, z.2]
  | 6 => ![r - z.1 - z.2, z.2, r + s, z.1]
  | _ => ![r - z.1 - z.2, z.1, z.2, r + s]

/-- The face coordinate of cell `f` (`x_k = 0` on a hexagon, `x_k = r + s` on a triangle). -/
def faceK (f : Fin 8) : Fin 4 := ![3, 2, 1, 0, 0, 1, 2, 3] f

def faceV (r s : ℤ) (f : Fin 8) : ℤ := if f.val < 4 then 0 else r + s

theorem phi_face (f : Fin 8) (z : ℤ × ℤ) : phi r s f z (faceK f) = faceV r s f := by
  fin_cases f <;> simp [phi, faceK, faceV]

theorem faceV_mem (f : Fin 8) : faceV r s f = 0 ∨ faceV r s f = r + s := by
  unfold faceV; split_ifs <;> simp

theorem phi_inS (hr : 0 < r) (hs : 0 < s) {f : Fin 8} {z : ℤ × ℤ} (h : CellIn r s f z) :
    InS r s (phi r s f z) := by
  rw [inS_iff]
  fin_cases f <;> simp [CellIn, HexIn, TriIn] at h <;> simp [phi] <;> omega

/-- The 36 directed edge gluings of C1: `(g, i, f, j, m)`. -/
def c1GlueTable : List (Fin 8 × ℕ × Fin 8 × ℕ × ℕ) :=
  [(0, 0, 2, 4, 1), (0, 1, 6, 2, 0), (0, 2, 3, 0, 1), (0, 3, 5, 0, 0), (0, 4, 1, 0, 5),
   (0, 5, 4, 2, 2), (1, 0, 0, 4, 1), (1, 1, 5, 2, 0), (1, 2, 3, 4, 5), (1, 3, 7, 0, 0),
   (1, 4, 2, 0, 5), (1, 5, 4, 0, 4), (2, 0, 1, 4, 1), (2, 1, 7, 2, 0), (2, 2, 3, 2, 3),
   (2, 3, 6, 0, 0), (2, 4, 0, 0, 5), (2, 5, 4, 1, 0), (3, 0, 0, 2, 5), (3, 1, 6, 1, 4),
   (3, 2, 2, 2, 3), (3, 3, 7, 1, 2), (3, 4, 1, 2, 1), (3, 5, 5, 1, 0), (4, 0, 1, 5, 2),
   (4, 1, 2, 5, 0), (4, 2, 0, 5, 4), (5, 0, 0, 3, 0), (5, 1, 3, 5, 0), (5, 2, 1, 1, 0),
   (6, 0, 2, 3, 0), (6, 1, 3, 1, 2), (6, 2, 0, 1, 0), (7, 0, 1, 3, 0), (7, 1, 3, 3, 4),
   (7, 2, 2, 1, 0)]

/-- C1 labels, independent of `r, s`. -/
def c1lb (g : Fin 8) (i : ℕ) : ℕ := (c1Lab g).getD (i % (c1Lab g).length) 0

theorem c1Sig_lb (r s : ℤ) (g : Fin 8) (i : ℕ) : (c1Sig r s).lb g i = c1lb g i := rfl

theorem c1_pairs : ∀ g : Fin 8, ∀ i : Fin 6, ∀ f : Fin 8, ∀ j : Fin 6,
    i.val < (c1Lab g).length → j.val < (c1Lab f).length →
    c1lb g i = c1lb f (j + 1) → c1lb g (i + 1) = c1lb f j →
    (g, i.val, f, j.val) ∈ c1GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  decide

theorem c1_poly_length (r s : ℤ) (g : Fin 8) : (c1Poly r s g).length = (c1Lab g).length := by
  fin_cases g <;> rfl

/-- The gluing data of a `SamePoint` step, reduced to the table and to a rotation `k < 6`. -/
theorem glue_cases {g f : Fin 8} {i j m : ℕ} {τ : ℤ × ℤ} (hG : (c1Sig r s).Glue g i f j m τ) :
    (g, i, f, j) ∈ c1GlueTable.map (fun e => (e.1, e.2.1, e.2.2.1, e.2.2.2.1)) := by
  obtain ⟨hi, hj, h1, h2, -, -⟩ := hG
  rw [c1Sig_lb, c1Sig_lb] at h1 h2
  have hlg : ((c1Sig r s).poly g).length ≤ 6 := by
    rw [show (c1Sig r s).poly g = c1Poly r s g from rfl, c1_poly_length]
    fin_cases g <;> decide
  have hlf : ((c1Sig r s).poly f).length ≤ 6 := by
    rw [show (c1Sig r s).poly f = c1Poly r s f from rfl, c1_poly_length]
    fin_cases f <;> decide
  have hi' : i < (c1Lab g).length := by rw [← c1_poly_length r s g]; exact hi
  have hj' : j < (c1Lab f).length := by rw [← c1_poly_length r s f]; exact hj
  exact c1_pairs g ⟨i, by omega⟩ f ⟨j, by omega⟩ hi' hj' h1 h2

set_option maxHeartbeats 4000000 in
theorem samePoint_phi_0 (hr : 0 < r) (hs : 0 < s) (f : Fin 8) (z w : ℤ × ℤ)
    (hz : CellIn r s 0 z) (hw : CellIn r s f w) (i j m : ℕ) (τ : ℤ × ℤ)
    (hG : (c1Sig r s).Glue (0 : Fin 8) i f j m τ) (hzw : rotN m z + τ = w) :
    phi r s 0 z = phi r s f w := by
  have hm := glue_cases hG
  obtain ⟨-, -, -, -, h3, h4⟩ := hG
  simp only [c1GlueTable, List.map_cons, List.map_nil, List.mem_cons, Prod.mk.injEq, Fin.isValue,
    Fin.reduceEq, true_and, false_and, false_or,
    List.not_mem_nil, or_false] at hm
  rw [rotN_mod6] at h3 h4 hzw
  have hm6 : m % 6 < 6 := Nat.mod_lt _ (by norm_num)
  generalize m % 6 = k at h3 h4 hzw hm6
  rcases hm with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ <;>
  · interval_cases k <;>
    · simp only [rotN, rot, Sig.pt, c1Sig, c1Poly, walk, Prod.ext_iff] at h3 h4 hzw
      simp [CellIn, TriIn, HexIn] at hz hw
      norm_num at h3 h4 hzw
      funext t
      fin_cases t <;> simp [phi] <;> omega

