theorem same (H : Hyp p r s w) (hr : 1 ≤ r) (hs : 1 ≤ s) (hp : 1 ≤ p) (hk : p % (2 * r + s) = k) (hK : k = 0) (hj : p / (2 * r + s) % 3 = 2) (hw : w = 2 * (2 * r + s) + k) (a b : (e10Sig p r s).Site) (h : (e10Sig p r s).SamePoint a b) :
    Phi p r s w a.1.1 a.1.2 = Phi p r s w b.1.1 b.1.2 := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  obtain ⟨⟨f, z'⟩, hz'⟩ := b
  obtain ⟨i, jj, mm, τ, hG, hzw⟩ := h
  have d1 := (incell hr hs hp hk hK g z).1 hz
  have d2 := (incell hr hs hp hk hK f z').1 hz'
  change Fin 5 at g f
  fin_cases g
  · exact same0 H hr hs hp hk hK hj hw d1 d2 hG hzw
  · exact same1 H hr hs hp hk hK hj hw d1 d2 hG hzw
  · exact same2 H hr hs hp hk hK hj hw d1 d2 hG hzw
  · exact same3 H hr hs hp hk hK hj hw d1 d2 hG hzw
  · exact same4 H hr hs hp hk hK hj hw d1 d2 hG hzw

