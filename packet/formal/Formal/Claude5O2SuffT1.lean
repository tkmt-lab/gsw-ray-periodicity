  by_cases h1 : k < (2 * d + 2)
  · right; left
    have h := wk_at (fT1_bs t d) (fT1_chain t d ht hd) 1 (by rw [fT1_len]; norm_num) (k - (2 * d)) (by show _ ≤ 2 * (fT1_1 t d).L; simp only [fT1_1] <;> omega)
    rw [show tot (List.take 1 (fT1_bs t d)) + (k - (2 * d)) = k by simp [fT1_bs, tot, fT1_0, fT1_1, fT1_2] <;> omega, show (fT1_bs t d).get ⟨1, _⟩ = fT1_1 t d from rfl] at h
    exact ⟨by omega, by omega, h⟩
  · right; right
    have h := wk_at (fT1_bs t d) (fT1_chain t d ht hd) 2 (by rw [fT1_len]; norm_num) (k - (2 * d + 2)) (by show _ ≤ 2 * (fT1_2 t d).L; simp only [fT1_2] <;> omega)
