theorem fT1_cls (t d : ℕ) (ht : t = 1) (hd : 3 ≤ d) (k : ℕ) (hk : k < (4 * d + 4)) : (k < (2 * d) ∧ wk (t : ℤ) (d : ℤ) (fT1_bs t d) k = (fT1_0 t d).pt t d (k - (0))) ∨ ((2 * d) ≤ k ∧ k < (2 * d + 2) ∧ wk (t : ℤ) (d : ℤ) (fT1_bs t d) k = (fT1_1 t d).pt t d (k - (2 * d))) ∨ ((2 * d + 2) ≤ k ∧ wk (t : ℤ) (d : ℤ) (fT1_bs t d) k = (fT1_2 t d).pt t d (k - (2 * d + 2))) := by
  by_cases h0 : k < (2 * d)
  · left
    have h := wk_at (fT1_bs t d) (fT1_chain t d ht hd) 0 (by rw [fT1_len]; norm_num) (k - (0)) (by show _ ≤ 2 * (fT1_0 t d).L; simp only [fT1_0] <;> omega)
