def inverseRotation : Rotation → Rotation := fun r =>
  (![
  ![(0,0),(0,2),(0,1)],
  ![(4,1),(1,1),(5,0)],
  ![(3,0),(6,0),(14,0)],
  ![(2,0),(10,0),(9,2)],
  ![(4,0),(1,0),(5,2)],
  ![(1,2),(5,1),(4,2)],
  ![(2,1),(10,1),(9,0)],
  ![(7,0),(15,2),(13,0)],
  ![(11,0),(19,1),(8,2)],
  ![(6,2),(14,2),(3,2)],
  ![(3,1),(6,1),(14,1)],
  ![(8,0),(11,1),(19,2)],
  ![(12,0),(16,2),(18,1)],
  ![(7,2),(15,1),(13,2)],
  ![(2,2),(10,2),(9,1)],
  ![(15,0),(13,1),(7,1)],
  ![(16,0),(18,2),(12,1)],
  ![(17,0),(17,1),(17,2)],
  ![(18,0),(12,2),(16,1)],
  ![(19,0),(8,1),(11,2)]] : Face → Corner → Dart) r.1 r.2

def rotateDart (r : Rotation) (d : Dart) : Dart :=
  let t := rotationFaces r.1 r.2 d.1
  (t.1,d.2+t.2)
def rotateLabel (r : Rotation) : ParentVertex → ParentVertex := rotationLabels r.1 r.2

theorem rotate_root : ∀ r, rotateDart r (0,0)=r := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem rotate_next (r : Rotation) (d : Dart) : rotateDart r (d.1,d.2+1)=
    ((rotateDart r d).1,(rotateDart r d).2+1) := by
  dsimp [rotateDart]
  congr 1
  ac_rfl
theorem rotate_mate : ∀ r d, rotateDart r (mate d)=mate (rotateDart r d) := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem rotate_turn : ∀ r d, rotateDart r (turn d)=turn (rotateDart r d) := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem rotate_labels : ∀ r f e,
    faceVertex (rotateDart r (f,e)).1 (rotateDart r (f,e)).2=rotateLabel r (faceVertex f e) := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem rotate_inverse : ∀ r d, rotateDart (inverseRotation r) (rotateDart r d)=d := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem inverse_rotate : ∀ r d, rotateDart r (rotateDart (inverseRotation r) d)=d := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem rotate_transitive : ∀ d e : Dart, ∃ r, rotateDart r d=e := by
  intro ⟨f,i⟩
  fin_cases f <;> fin_cases i <;> decide +kernel
theorem rotate_identity : ∀ d, rotateDart (0,0) d=d := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel
theorem labels_bijective : ∀ r, Function.Bijective (rotateLabel r) := by
  intro r
  rcases r with ⟨f,e⟩
  fin_cases f <;> fin_cases e <;> decide +kernel

def dartRotation (r : Rotation) : Dart ≃ Dart where
  toFun := rotateDart r
  invFun := rotateDart (inverseRotation r)
  left_inv := rotate_inverse r
  right_inv := inverse_rotate r

theorem rotation_distinct : Function.Injective rotateDart := by
  intro r s h
  have := congrFun h (0,0)
  simpa only [rotate_root] using this

theorem rotation_card : Fintype.card Rotation=60 := by decide +kernel
end R002.Icosahedron
