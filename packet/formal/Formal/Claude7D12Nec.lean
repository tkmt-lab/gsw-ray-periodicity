    · obtain ⟨Qp, rfl⟩ : ∃ Qp, Q = Qp + 1 := ⟨Q - 1, by omega⟩
      have hw : q * r = 2 * (Qp * r) + 2 * r := by rw [hQ]; ring
      exact sp8_K0 r s Qp hr (by omega) (by omega) (by omega) (by omega) hp (by rw [h0, pt_0]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq)) (by rw [h1, pt_1]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq)) (by rw [h2, pt_2]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq))
    · have hw : q * r = 2 * (Q * r) + r := by rw [hQ]; ring
      exact sp8_K1 r s Q hr (by omega) (by omega) (by omega) (by omega) hp (by rw [h0, pt_0]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq)) (by rw [h1, pt_1]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq)) (by rw [h2, pt_2]; simp only [sp8_pre] <;> first | rfl | (congr 1; d12peq))

theorem st9 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) (n1 : ¬ ((r : ℤ) ∣ (s : ℤ) - 1)) (n2 : ¬ ((r : ℤ) ∣ (s : ℤ) + 1)) (n3 : |(r : ℤ) - 3 * (s : ℤ)| ≠ 1) {n : ℕ} {p : ℕ → MS (r : ℤ) (s : ℤ)} (hp : LiteralPath (GM (r : ℤ) (s : ℤ)) n p) (h0 : (p 0).1 = ch (r : ℤ) (s : ℤ) 1 ((0), (0))) (h1 : (p 1).1 = ch (r : ℤ) (s : ℤ) 1 ((-1), (1))) (h2 : (p 2).1 = ch (r : ℤ) (s : ℤ) 1 ((0), (1))) : False := by
  obtain ⟨a1, a2, a3, a4⟩ := neg_lines r s hr hs n1 n2 n3
  rcases (show n9_0_R r s by simp only [n9_0_R]; omega) with h
  · exact n9_0_kill r s h hp h0 h1 h2

theorem ch0_00 (hr : 1 ≤ (r : ℤ)) (hs : 1 ≤ (s : ℤ)) : ch (r : ℤ) (s : ℤ) 0 (0, 0) = (2, (0, 0)) := by
  rw [ch0_B (by simp [I0])]; simp [a0]
theorem ch1_00 (hr : 1 ≤ (r : ℤ)) (hs : 1 ≤ (s : ℤ)) : ch (r : ℤ) (s : ℤ) 1 (0, 0) = (2, (0, 0)) := by
  rw [ch1_B (by simp [I1])]; simp [a1]

/-- **No literal path starts at the label-0 point** (the condition failing, `r, s ≥ 2`). -/
theorem no_label0 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) (n1 : ¬ ((r : ℤ) ∣ (s : ℤ) - 1)) (n2 : ¬ ((r : ℤ) ∣ (s : ℤ) + 1)) (n3 : |(r : ℤ) - 3 * (s : ℤ)| ≠ 1) {n : ℕ} {p : ℕ → MS (r : ℤ) (s : ℤ)} (hp : LiteralPath (GM (r : ℤ) (s : ℤ)) n p) (h0 : (p 0).1 = (2, (0, 0))) : False := by
  have hr1 : (1 : ℤ) ≤ (r : ℤ) := by exact_mod_cast (show 1 ≤ r by omega)
  have hs1 : (1 : ℤ) ≤ (s : ℤ) := by exact_mod_cast (show 1 ≤ s by omega)
  have a01 : AdjM (r : ℤ) (s : ℤ) (p 0).1 (p 1).1 := hp.2.2.2.1 0 (by have := hp.1; omega)
  have a02 : AdjM (r : ℤ) (s : ℤ) (p 0).1 (p 2).1 := hp.2.2.2.2.1 0 (by have := hp.1; omega)
  have a12 : AdjM (r : ℤ) (s : ℤ) (p 1).1 (p 2).1 := hp.2.2.2.1 1 (by have := hp.1; omega)
  obtain ⟨c, a, b, q, ha, hb, hq, hu, hap⟩ := place hr1 hs1 a01 a02 a12
  rw [h0] at ha
  have hc := ha.1
  have ha0 : a = (0, 0) := by
    rcases fib_seam hr1 hs1 ha.1 ha.2.1 ha.2.2 with ⟨rfl, e⟩ | ⟨rfl, e⟩
    · rw [e]; exact P0_lab0 hr1 hs1
    · rw [e]; exact P1_lab0 hr1 hs1
  subst ha0
  obtain ⟨-, hbD, hb3⟩ := hb
  obtain ⟨-, hqD, hq3⟩ := hq
  have hb' : b ∈ unitVec := by
    have e : b - (0, 0) = b := by ext <;> simp
    rw [e] at hu; exact hu
  rw [unit_iff] at hb'
  rcases c_cases hc with rfl | rfl
  · rcases hb' with rfl | rfl | rfl | rfl | rfl | rfl
    · rcases hap with hq' | hq'
      · have hq'' : q = (0, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st0 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
      · have hq'' : q = (1, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
    · rcases hap with hq' | hq'
      · have hq'' : q = (-1, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st2 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
      · have hq'' : q = (1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st1 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
    · rcases hap with hq' | hq'
      · have hq'' : q = (-1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st4 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
      · have hq'' : q = (0, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st3 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
    · rcases hap with hq' | hq'
      · have hq'' : q = (0, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (-1, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st5 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch0_00 hr1 hs1).symm) hb3.symm hq3.symm
    · rcases hap with hq' | hq'
      · have hq'' : q = (1, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (-1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
    · rcases hap with hq' | hq'
      · have hq'' : q = (1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (0, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
  · rcases hb' with rfl | rfl | rfl | rfl | rfl | rfl
    · rcases hap with hq' | hq'
      · have hq'' : q = (0, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st6 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch1_00 hr1 hs1).symm) hb3.symm hq3.symm
      · have hq'' : q = (1, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
    · rcases hap with hq' | hq'
      · have hq'' : q = (-1, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st8 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch1_00 hr1 hs1).symm) hb3.symm hq3.symm
      · have hq'' : q = (1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st7 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch1_00 hr1 hs1).symm) hb3.symm hq3.symm
    · rcases hap with hq' | hq'
      · have hq'' : q = (-1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (0, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exact st9 r s hr hs n1 n2 n3 hp (by rw [h0]; exact (ch1_00 hr1 hs1).symm) hb3.symm hq3.symm
    · rcases hap with hq' | hq'
      · have hq'' : q = (0, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (-1, 1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
    · rcases hap with hq' | hq'
      · have hq'' : q = (1, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (-1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
    · rcases hap with hq' | hq'
      · have hq'' : q = (1, 0) := by rw [hq']; ext <;> simp [rotL, rotR]
        subst hq''
        exfalso; simp only [Dom, H0, H1] at hbD hqD; omega
      · have hq'' : q = (0, -1) := by rw [hq']; ext <;> simp [rotL, rotR]
