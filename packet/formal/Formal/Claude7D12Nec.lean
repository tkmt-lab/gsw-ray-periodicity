/-- **Necessity in the model.** -/
theorem no_path_gm (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) (n1 : ¬ ((r : ℤ) ∣ (s : ℤ) - 1)) (n2 : ¬ ((r : ℤ) ∣ (s : ℤ) + 1)) (n3 : |(r : ℤ) - 3 * (s : ℤ)| ≠ 1) :
    ¬ ∃ n q, LiteralPath (GM (r : ℤ) (s : ℤ)) n q := by
  rintro ⟨n, p, hp⟩
  obtain ⟨q, hq, hq0⟩ := to_label0 (by exact_mod_cast hr) (by exact_mod_cast hs) hp
  exact no_label0 r s hr hs n1 n2 n3 hq hq0

/-- **Necessity for D12.** -/
theorem d12_no_path (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) (n1 : ¬ ((r : ℤ) ∣ (s : ℤ) - 1)) (n2 : ¬ ((r : ℤ) ∣ (s : ℤ) + 1)) (n3 : |(r : ℤ) - 3 * (s : ℤ)| ≠ 1) :
    ¬ ∃ n p, LiteralPath (d12Graph (r : ℤ) (s : ℤ)) n p := by
  rw [d12_iff_gm (by exact_mod_cast (show 1 ≤ r by omega)) (by exact_mod_cast (show 1 ≤ s by omega))]
  exact no_path_gm r s hr hs n1 n2 n3

