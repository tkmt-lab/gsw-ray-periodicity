theorem canon (H : Hyp p r s w) (hr : 1 ≤ r) (hs : 1 ≤ s) (hp : 1 ≤ p) (hk : p % (2 * r + s) = k) (hK : r < k) (hj : p / (2 * r + s) % 3 = 2) (hw : w = 2 * (2 * r + s) + k) (a : (e10Sig p r s).Site)
    (h : (e10Sig p r s).InCell (cpt r s (Phi p r s w a.1.1 a.1.2)).1 (cpt r s (Phi p r s w a.1.1 a.1.2)).2) :
    Relation.EqvGen (e10Sig p r s).SamePoint a ⟨cpt r s (Phi p r s w a.1.1 a.1.2), h⟩ := by
  obtain ⟨⟨g, z⟩, hz⟩ := a
  change Fin 5 at g
  have key : ∃ b : (e10Sig p r s).Site,
      Relation.EqvGen (e10Sig p r s).SamePoint ⟨(g, z), hz⟩ b ∧ b.1 = cpt r s (Phi p r s w g z) := by
    fin_cases g
    · exact canon0 H hr hs hp hk hK hj hw hz
    · exact canon1 H hr hs hp hk hK hj hw hz
    · exact canonS H hr hs hp hk hK hj hw (by simp) hz
    · exact canonS H hr hs hp hk hK hj hw (by simp) hz
    · exact canonS H hr hs hp hk hK hj hw (by simp) hz
  obtain ⟨b, hb, hb'⟩ := key
  exact Relation.EqvGen.trans _ _ _ hb (eqv_of_val hb')

theorem isoOK (H : Hyp p r s w) (hr : 1 ≤ r) (hs : 1 ≤ s) (hp : 1 ≤ p) (hk : p % (2 * r + s) = k) (hK : r < k) (hj : p / (2 * r + s) % 3 = 2) (hw : w = 2 * (2 * r + s) + k) : IsoOK p r s w :=
  ⟨incell hr hs hp hk hK, same H hr hs hp hk hK hj hw, canon H hr hs hp hk hK hj hw⟩

