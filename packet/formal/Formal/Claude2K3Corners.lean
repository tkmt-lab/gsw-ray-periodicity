import Formal.Claude2K3Sufficient

/-!
# K3 aligned surface, part 6: all twelve corners have degree 5

Written by a Claude worker (2026-10-19).  `cornerRep a` is a hexagon corner carrying label `a`
(every label of K3 occurs at a hexagon corner); `deg_corner` says its vertex has degree 5, for all
`r, s ≥ 2`.  The proofs of the eight new cases are generated by
`studies/R002/claude-lean/claude2_k3_gen_corners.py` in the same way as `Claude2K3Degree.lean`;
labels `0, 6, 8, 10` reuse `deg_top_corner` and `deg_bot_corner_*`.
-/

set_option linter.unusedSimpArgs false

namespace Claude2K3
open ClaudeChallenge Claude2Aligned
variable {r s : ℤ}

theorem deg_corner_1 (hr : 2 ≤ r) (hs : 2 ≤ s) :
    deg (k3Graph r s) (V r s 8 (r, 0)) = 5 := by
  have hr0 : 0 < r := by omega
  have hs0 : 0 < s := by omega
  rw [deg_eq hr0 hs0 (V r s 8 (r, 0)) [((8 : Fin 11), (r, 0)), ((0 : Fin 11), (r, 0)), ((1 : Fin 11), (0, r)), ((3 : Fin 11), (0, 0))]
    ([((8 : Fin 11), (r, 1)), ((8 : Fin 11), (r - 1, 1)), ((8 : Fin 11), (r - 1, 0)), ((0 : Fin 11), (r - 1, 1)), ((1 : Fin 11), (1, r - 1))].map (fun p => V r s p.1 p.2)) ?_ ?_ ?_ ?_]
  · rfl
  · intro g w hw hV
    have hi := V_inv hr0 hs0 hw (by simp [CellIn, TriIn, HexIn] <;> omega) hV
    fin_cases g <;> simp [inv, hgt, ang, nrm, CellIn, TriIn, HexIn, Prod.ext_iff] at hw hi ⊢ <;>
      (try split_ifs at hi) <;> omega
  · intro c hc u hu hcell
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    simp only [unitVec, List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hc with rfl | rfl | rfl | rfl <;> rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;> dsimp only at hcell ⊢
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exact Or.inr (List.mem_map.2 ⟨((8 : Fin 11), (r, 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((8 : Fin 11), (r - 1, 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((8 : Fin 11), (r - 1, 0)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exact Or.inr (List.mem_map.2 ⟨((0 : Fin 11), (r - 1, 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((8 : Fin 11), (r, 1)), by simp,
        V_glue hr0 hs0 (gl_8_1 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)⟩)
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exact Or.inr (List.mem_map.2 ⟨((8 : Fin 11), (r - 1, 0)), by simp,
        V_glue hr0 hs0 (gl_8_0 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((1 : Fin 11), (1, r - 1)), by simp,
        V_congr (by ext <;> simp <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((1 : Fin 11), (1, r - 1)), by simp,
        V_glue hr0 hs0 (gl_1_1 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)⟩)
    · exact Or.inr (List.mem_map.2 ⟨((0 : Fin 11), (r - 1, 1)), by simp,
        V_glue hr0 hs0 (gl_0_1 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)⟩)
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
    · exfalso; simp [CellIn, TriIn, HexIn] at hcell <;> omega
  · intro w hw
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hw
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl <;> dsimp only
    · exact V_adj hr0 hs0 (z := (r, 0)) (rfl) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)
        (0, 1) (by simp [unitVec]) (by ext <;> simp <;> omega)
        (by simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)
    · exact V_adj hr0 hs0 (z := (r, 0)) (rfl) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)
        (-1, 1) (by simp [unitVec]) (by ext <;> simp <;> omega)
        (by simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)
    · exact V_adj hr0 hs0 (z := (r, 0)) (rfl) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)
        (-1, 0) (by simp [unitVec]) (by ext <;> simp <;> omega)
        (by simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)
    · exact V_adj hr0 hs0 (z := (r, 0)) (V_glue hr0 hs0 (gl_8_1 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)
        (-1, 1) (by simp [unitVec]) (by ext <;> simp <;> omega)
        (by simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)
    · exact V_adj hr0 hs0 (z := (0, r)) (V_glue hr0 hs0 (gl_8_0 (r := r) (s := s)) (by ext <;> simp [rotN, rot] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)) (by simp [CellIn, TriIn, HexIn] <;> omega) (by simp [CellIn, TriIn, HexIn] <;> omega)
        (1, -1) (by simp [unitVec]) (by ext <;> simp <;> omega)
        (by simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)
  · apply nodup_V hr0 hs0
    · simp only [List.mem_cons, List.not_mem_nil, or_false]
      rintro p (rfl | rfl | rfl | rfl | rfl) <;> simp [CellIn, TriIn, HexIn] <;> omega
    · simp only [List.map_cons, List.map_nil, List.nodup_cons, List.mem_cons, List.not_mem_nil,
        or_false, not_or, List.nodup_nil, and_true]
      repeat' apply And.intro
      all_goals (simp [inv, hgt, ang, nrm, Prod.ext_iff] <;> (try split_ifs) <;> omega)

