/-- A hexagon corner carrying label `a`: (cell, corner index). -/
def cornerRep : Fin 12 → Fin 11 × ℕ :=
  ![(10, 0), (8, 1), (9, 2), (9, 1), (10, 2), (10, 1), (10, 5), (8, 4), (8, 5), (9, 4), (9, 5),
    (10, 4)]

theorem cornerRep_label (a : Fin 12) : k3lb (cornerRep a).1 (cornerRep a).2 = a := by
  fin_cases a <;> decide

/-- **The twelve corners of K3(r,s) have degree 5** (`r, s ≥ 2`). -/
theorem deg_corner (hr : 2 ≤ r) (hs : 2 ≤ s) (a : Fin 12) :
    deg (k3Graph r s)
      (V r s (cornerRep a).1 ((k3Sig r s).pt (cornerRep a).1 (cornerRep a).2)) = 5 := by
  fin_cases a <;> simp [cornerRep, Sig.pt, k3Sig, k3Poly, walk, rotN, rot]
  · exact deg_top_corner hr hs
  · exact deg_corner_1 hr hs
  · exact deg_corner_2 hr hs
  · exact deg_corner_3 hr hs
  · exact deg_corner_4 hr hs
  · exact deg_corner_5 hr hs
  · exact deg_bot_corner_10 hr hs
  · exact deg_corner_7 hr hs
  · exact deg_bot_corner_8 hr hs
  · exact deg_corner_9 hr hs
  · exact deg_bot_corner_9 hr hs
  · exact deg_corner_11 hr hs

end Claude2K3

