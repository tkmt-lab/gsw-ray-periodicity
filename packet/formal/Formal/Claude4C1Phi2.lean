import Formal.Claude4C1Phi

/-!
# C1: the vertices of `c1Graph` are exactly the points of the `ℤ⁴` model

Written by a Claude worker (2026-10-20, C1 bridge session).  The per-cell cases of `eqv_of_phi`
are generated by `gen_phi2.py` (session scratchpad).

* `gl_g_i`      : the 36 gluings with explicit translations;
* `eqv_of_phi`  : two sites with the same image in `ℤ⁴` are the same vertex (for a pair of cells
                  sharing a side, one gluing step; cells that do not touch have disjoint images);
* `psi`, `psi_spec` : every point of a face of the model is the image of a lattice point of the
                  corresponding cell.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Claude4C1

open ClaudeChallenge Claude2Aligned

variable {r s : ℤ}

macro "glue_tac" : tactic =>
  `(tactic| (refine ⟨by simp [c1Sig, c1Poly, walk], by simp [c1Sig, c1Poly, walk],
      by rw [c1Sig_lb, c1Sig_lb]; decide, by rw [c1Sig_lb, c1Sig_lb]; decide, ?_, ?_⟩ <;>
    simp [Sig.pt, c1Sig, c1Poly, walk, rotN, rot, Prod.ext_iff] <;> omega))

