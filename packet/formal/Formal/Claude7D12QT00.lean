theorem q0_deg1 (r s : ℕ) (hr : 2 ≤ r) (hs : 2 ≤ s) (w : MS (r : ℤ) (s : ℤ)) (hw : w.1 = ch (r : ℤ) (s : ℤ) 0 ((1), (0))) : deg (GM (r : ℤ) (s : ℤ)) w = 6 := by
