#!/usr/bin/env python3
"""O2 (Graver) as Claude2Aligned-style labelled polygons; mirror checks of Claude5O2Spec.lean.

Parameters: Lean/paper (t, d) = R004 o2.py (r, s).  Check: twice the total area is
2(4t^2 + 8td + d^2) + 6t^2 = 14t^2 + 16td + 2d^2, the paper's O2 carbon order (appendix table).

Cells (re-derived from R004's independent o2.py, read-only): labels A_i, B_i, C_i, D_i
(i = 0, 1, 2) encoded as 4i + 0, 1, 2, 3.
  cell 0 (H0): A0 B0 C0 A1 B1 C1 A2 B2 C2, cell 1 (H1): C2 D2 A2 C1 D1 A1 C0 D0 A0,
  both the hexagon with sides 2t, d, 2t, d, 2t, d whose 2t-sides carry a straight-angle
  midpoint corner: walk [(t,0),(t,0),(d,1),(t,2),(t,2),(d,3),(t,4),(t,4),(d,5)];
  cells 2 + 2i, 3 + 2i: the t-triangles [C_i, B_i, D_i], [B_i, A_i, D_i]: walk
  [(t,0),(t,2),(t,4)].
Checks for each grid point, on the Lean-literal surface (claude2_aligned_mirror.Surface):
  vertex/edge counts and degree sequence against R004 o2.construct; isomorphism with it
  (R004 canonical_fast on rotation systems); twelve degree-5 vertices; no off-seam
  identification (same partition and edges as R004 aligned_surface on the same data,
  injective charts, glued pairs only on boundaries); literal-path existence (exhaustive).
Usage: o2_mirror.py MIRROR_DIR R004_SRC OUT.json
"""
import json
import sys
from itertools import product

HERE, R004 = sys.argv[1], sys.argv[2]
sys.path.insert(0, HERE)
sys.path.insert(1, R004)
from claude2_aligned_mirror import (Surface, walk, literal_path_exists,  # noqa: E402
                                    check_literal, r004_compare)
from graphs import from_oriented_triangles  # noqa: E402
from canonical_fast import canonical_fast  # noqa: E402
import o2 as r004_o2  # noqa: E402

# ---------------------------------------------------------------- Lean data (Claude5O2Spec)
O2_LAB = [[0, 1, 2, 4, 5, 6, 8, 9, 10], [10, 11, 8, 6, 7, 4, 2, 3, 0],
          [2, 1, 3], [1, 0, 3], [6, 5, 7], [5, 4, 7], [10, 9, 11], [9, 8, 11]]


def o2_poly(t, d, f):
    if f < 2:
        return walk((0, 0), [(t, 0), (t, 0), (d, 1), (t, 2), (t, 2), (d, 3), (t, 4), (t, 4), (d, 5)])
    return walk((0, 0), [(t, 0), (t, 2), (t, 4)])


def o2_sig(t, d):
    return O2_LAB, [o2_poly(t, d, f) for f in range(8)]


# ---------------------------------------------------------------- generic checks


def rotation_system(S):
    """Oriented unit triangles of every cell (whole bounding box), as vertex classes, turned
    into an R004 rotation system (this also asserts every dart lies in exactly one triangle)."""
    tri = []
    for f in range(S.N):
        P = S.poly[f]
        for x, y in product(range(min(a for a, _ in P), max(a for a, _ in P) + 1),
                            range(min(b for _, b in P), max(b for _, b in P) + 1)):
            for trip in (((x, y), (x + 1, y), (x, y + 1)), ((x + 1, y), (x + 1, y + 1), (x, y + 1))):
                if all((f, q) in S.index for q in trip):
                    tri.append(tuple(S.cls[S.index[f, q]] for q in trip))
    return from_oriented_triangles(tri), len(tri)


def charts_injective(S):
    seen = {}
    for k, (f, z) in enumerate(S.sites):
        if seen.setdefault((f, S.cls[k]), z) != z:
            return False
    return True


def check_case(lab, poly, construct_graph, area2):
    S = Surface(lab, poly)
    E = sum(S.deg) // 2
    G = construct_graph
    rot, ntri = rotation_system(S)
    rec = {"V": S.V, "E": E, "V_r004": len(G), "E_r004": sum(len(x) for x in G) // 2,
           "deg5": S.deg.count(5), "other_deg": sorted(set(S.deg) - {5, 6}),
           "deg_seq_eq": sorted(S.deg) == sorted(len(x) for x in G),
           "triangles": ntri, "area2": area2,
           "tri_edges_eq_adj": all(set(rot[v]) == S.adj[v] for v in range(S.V)),
           "boundary_only": S.boundary_only(), "charts_injective": charts_injective(S),
           "same_as_aligned_surface": r004_compare(S, lab, poly, R004)[0]}
    rec["iso_r004"] = canonical_fast(rot) == canonical_fast(G)
    w = literal_path_exists(S, want_witness=True)
    rec["path"] = w is not None
    if w is not None:
        assert check_literal(S, w)
    rec["ok"] = (rec["V"] == rec["V_r004"] and rec["E"] == rec["E_r004"] and rec["deg_seq_eq"]
                 and rec["deg5"] == 12 and not rec["other_deg"] and ntri == area2
                 and rec["tri_edges_eq_adj"] and rec["boundary_only"] and rec["charts_injective"]
                 and rec["same_as_aligned_surface"] and rec["iso_r004"])
    return rec


def main():
    rows = []
    for t in range(1, 9):
        for d in range(1, 11):
            lab, poly = o2_sig(t, d)
            rec = {"t": t, "d": d}
            rec.update(check_case(lab, poly, r004_o2.construct(t, d), 14 * t * t + 16 * t * d + 2 * d * d))
            rows.append(rec)
    bad = [x for x in rows if not x["ok"]]
    paper = [x for x in rows if x["t"] >= 2 and x["d"] >= 2]
    summary = {"cases": len(rows), "bad": len(bad),
               "paper_domain_t_d_ge_2": len(paper),
               "paper_domain_all_absent": all(not x["path"] for x in paper),
               "positives": sorted((x["t"], x["d"]) for x in rows if x["path"]),
               "negatives_with_param_1": sorted((x["t"], x["d"]) for x in rows
                                                if not x["path"] and min(x["t"], x["d"]) == 1)}
    print(json.dumps(summary))
    json.dump({"summary": summary, "rows": rows}, open(sys.argv[3], "w"), indent=0)


if __name__ == "__main__":
    main()
